{"subject_id": "0b36ea19-5877-4077-a8bd-c62313d37658", "tema": 2, "practica": "Práctica general: operaciones combinadas con racionales", "examen_titulo": "Nivel jefe: operaciones combinadas con racionales", "niveles": {"1": {"objetivo": "Vas a resolver cuentas combinadas con fracciones respetando el orden de las operaciones: paréntesis, potencias, multiplicaciones y divisiones, y por último sumas y restas.", "vas_a_ver": ["El orden de las operaciones", "Sumar y restar fracciones", "Multiplicar y dividir fracciones", "Resolver paso a paso"], "secciones": [{"etapa": 1, "titulo": "El orden de las operaciones", "bloques": [{"tipo": "definicion", "titulo": "Jerarquía de operaciones", "texto": "Se resuelve primero lo que está entre <b>paréntesis</b>, después las <b>potencias y raíces</b>, luego las <b>multiplicaciones y divisiones</b> (de izquierda a derecha) y al final las <b>sumas y restas</b>."}, {"tipo": "importante", "titulo": "Idea clave", "texto": "Con fracciones el orden es el mismo que con enteros: la multiplicación se resuelve antes que la suma."}]}, {"etapa": 1, "titulo": "Las cuatro operaciones", "bloques": [{"tipo": "tabla", "titulo": "Operaciones con fracciones", "columnas": ["Operación", "Cómo se hace"], "filas": [["Suma y resta", "Denominador común, y se operan los numeradores"], ["Multiplicación", "Numerador por numerador y denominador por denominador"], ["División", "Se multiplica por la inversa de la segunda"]], "iguales": true}]}, {"etapa": 2, "titulo": "Un ejemplo completo", "bloques": [{"tipo": "ejemplo", "titulo": "Resolver 1/2 + 1/3 × 3/4", "texto": "Primero la multiplicación.", "items": ["1/3 × 3/4 = 3/12 = 1/4.", "Ahora la suma: 1/2 + 1/4 = 2/4 + 1/4.", "El resultado es 3/4."]}]}, {"etapa": 2, "titulo": "Con una división", "bloques": [{"tipo": "ejemplo", "titulo": "Resolver 2/3 − 1/6 ÷ 1/2", "texto": "Primero la división.", "items": ["1/6 ÷ 1/2 = 1/6 × 2 = 2/6 = 1/3.", "Ahora la resta: 2/3 − 1/3.", "El resultado es 1/3."]}]}], "ejemplo_completo": {"titulo": "Orden de las operaciones", "planteo": "Resolvé 3/4 − 1/2 × 1/2.", "pasos": ["Primero la multiplicación: 1/2 × 1/2 = 1/4.", "Después la resta: 3/4 − 1/4 = 2/4.", "Simplificado, el resultado es 1/2."]}, "ejemplo_incompleto": {"titulo": "Completá", "planteo": "Completá la cuenta 1/2 + 2/3 × 3/4.", "pasos": ["Primero se resuelve la ___ : 2/3 × 3/4 = 6/12 = 1/2.", "Después se suma: 1/2 + 1/2 = ___ .", "El resultado es 1."]}, "ejemplo_solo": {"titulo": "tu turno", "planteo": "Resolvé 5/6 − 1/3 ÷ 2 y 1/2 + 1/4 × 2, y explicá qué hiciste primero."}, "tip": {"titulo": "Subrayá lo primero", "texto": "Antes de calcular, subrayá la multiplicación o la división: eso se resuelve antes que la suma o la resta."}, "ojo": ["Sumar primero: 1/2 + 1/3 × 3/4 no es 5/6 × 3/4.", "Dividir sin dar vuelta la segunda fracción."], "resumen": [{"titulo": "Orden", "texto": "Paréntesis, potencias, × y ÷, + y −."}, {"titulo": "Suma y resta", "texto": "Con denominador común."}, {"titulo": "Multiplicación", "texto": "Arriba con arriba y abajo con abajo."}, {"titulo": "División", "texto": "Se multiplica por la inversa."}], "glosario": [{"palabra": "Jerarquía", "significado": "Orden en que se resuelven las operaciones."}, {"palabra": "Inversa", "significado": "La fracción dada vuelta: la de 2/3 es 3/2."}, {"palabra": "Denominador común", "significado": "Denominador igual para sumar o restar."}, {"palabra": "Simplificar", "significado": "Dividir arriba y abajo por el mismo número."}], "carpeta": ["¿Cuánto es 1/2 + 1/3 × 3/4? Escribilo como fracción.", "¿Cuánto es 1/2 ÷ 1/4?", "¿Cuánto es 3/4 − 1/2 × 1/2? Escribilo como fracción.", "Un compañero resolvió 1/2 + 1/3 × 3/4 sumando primero y le dio 5/8. ¿Cuál es el resultado correcto?"], "carpeta_nivel": ["aplicar", "aplicar", "aplicar", "error"], "respuestas_carpeta": [["3/4"], ["2"], ["1/2"], ["3/4"]], "soluciones": {"incompleto": "Multiplicación. 1.", "solo": "5/6 − 1/6 = 4/6 = 2/3. 1/2 + 1/2 = 1. Primero se resuelve la división y la multiplicación.", "carpeta": ["3/4.", "2.", "1/2.", "3/4: primero va la multiplicación."]}}, "2": {"objetivo": "Vas a resolver cuentas que mezclan fracciones y decimales, pasando todo a un mismo formato.", "vas_a_ver": ["Elegir el formato", "Pasar todo a fracción", "Pasar todo a decimal", "Con decimales periódicos"], "secciones": [{"etapa": 1, "titulo": "Un mismo formato", "bloques": [{"tipo": "parrafo", "texto": "Para operar fracciones y decimales juntos, conviene pasar todo a <b>fracción</b> o todo a <b>decimal</b>. Si hay un decimal periódico, siempre se pasa todo a fracción."}, {"tipo": "importante", "titulo": "Idea clave", "texto": "No se puede sumar una fracción con un decimal sin unificar: primero se elige el formato."}]}, {"etapa": 1, "titulo": "Todo a fracción", "bloques": [{"tipo": "ejemplo", "titulo": "Resolver 0,5 + 1/4", "texto": "0,5 = 1/2.", "items": ["0,5 = 5/10 = 1/2.", "1/2 + 1/4 = 2/4 + 1/4.", "El resultado es 3/4, o 0,75."]}]}, {"etapa": 2, "titulo": "Todo a decimal", "bloques": [{"tipo": "ejemplo", "titulo": "Resolver 2/5 × 0,5", "texto": "2/5 = 0,4.", "items": ["2/5 = 0,4.", "0,4 × 0,5 = 0,2.", "El resultado es 0,2, o 1/5."]}]}, {"etapa": 2, "titulo": "Con periódicos", "bloques": [{"tipo": "parrafo", "texto": "Si hay un periódico como 0,333… se pasa a fracción: 0,333… = 1/3. Entonces 0,333… + 1/6 = 1/3 + 1/6 = 2/6 + 1/6 = 1/2."}]}], "ejemplo_completo": {"titulo": "Fracción y decimal", "planteo": "Resolvé 0,25 ÷ 1/2.", "pasos": ["0,25 = 1/4.", "1/4 ÷ 1/2 = 1/4 × 2 = 2/4.", "El resultado es 1/2, o 0,5."]}, "ejemplo_incompleto": {"titulo": "Completá", "planteo": "Completá la cuenta 0,2 + 3/10.", "pasos": ["0,2 = 2/10.", "2/10 + 3/10 = ___ /10.", "5/10 = 1/2, o 0,5."]}, "ejemplo_solo": {"titulo": "tu turno", "planteo": "Resolvé 0,75 + 1/8 y 1/3 × 0,6, y decidí en cada caso si pasaste a fracción o a decimal."}, "tip": {"titulo": "Un solo formato", "texto": "Elegí el formato más cómodo: decimales exactos, todo a decimal; con un periódico, todo a fracción."}, "ojo": ["Sumar 0,5 + 1/4 como 1,5/4: no se suman los numeradores sin denominador común.", "Pasar un periódico a decimal redondeado."], "resumen": [{"titulo": "Mismo formato", "texto": "Todo a fracción o todo a decimal."}, {"titulo": "Periódico", "texto": "Se pasa siempre a fracción."}, {"titulo": "0,5", "texto": "Es 1/2."}, {"titulo": "0,25", "texto": "Es 1/4."}], "glosario": [{"palabra": "Unificar", "significado": "Pasar todo al mismo formato."}, {"palabra": "Decimal exacto", "significado": "El que termina."}, {"palabra": "Periódico", "significado": "El que repite cifras."}, {"palabra": "Equivalente", "significado": "Que vale lo mismo."}], "carpeta": ["¿Cuánto es 0,5 + 1/4? Escribilo como fracción.", "¿Cuánto es 2/5 × 0,5? Escribilo como decimal.", "Si hay un decimal periódico, ¿conviene pasar todo a fracción o a decimal? Escribí fracción o decimal.", "Un compañero calculó 0,5 + 1/4 como 0,375 sumando 1,5 sobre 4. ¿Cuál es el resultado correcto en decimal?"], "carpeta_nivel": ["aplicar", "aplicar", "analizar", "error"], "respuestas_carpeta": [["3/4"], ["0,2", "0.2"], ["fracción", "fraccion"], ["0,75", "0.75"]], "soluciones": {"incompleto": "5.", "solo": "0,75 + 1/8 = 7/8. 1/3 × 0,6 = 1/5.", "carpeta": ["3/4.", "0,2.", "Fracción.", "0,75: 1/2 + 1/4."]}}, "3": {"objetivo": "Vas a resolver cuentas con potencias de fracciones y paréntesis, respetando el orden.", "vas_a_ver": ["Potencia de una fracción", "Signos y potencias", "Paréntesis primero", "Cuentas combinadas con potencias"], "secciones": [{"etapa": 1, "titulo": "Potencia de una fracción", "bloques": [{"tipo": "definicion", "titulo": "Potencia de una fracción", "texto": "Se eleva <b>el numerador y el denominador</b>: (a/b)² = a²/b²."}, {"tipo": "tabla", "titulo": "Ejemplos", "columnas": ["Cuenta", "Resultado"], "filas": [["(1/2)²", "1/4"], ["(2/3)²", "4/9"], ["(2/3)³", "8/27"]], "iguales": true}]}, {"etapa": 1, "titulo": "Signos", "bloques": [{"tipo": "parrafo", "texto": "Si el exponente es <b>par</b>, el resultado es positivo. Si es <b>impar</b>, conserva el signo de la base: (−1/2)² = 1/4 y (−1/2)³ = −1/8."}]}, {"etapa": 2, "titulo": "Paréntesis primero", "bloques": [{"tipo": "ejemplo", "titulo": "Resolver (1/2 + 1/4)²", "texto": "Primero el paréntesis.", "items": ["1/2 + 1/4 = 3/4.", "(3/4)² = 9/16.", "El resultado es 9/16."]}]}, {"etapa": 2, "titulo": "Combinadas", "bloques": [{"tipo": "ejemplo", "titulo": "Resolver 1/3 + (1/2)² × 4", "texto": "Potencia, multiplicación y suma.", "items": ["(1/2)² = 1/4.", "1/4 × 4 = 1.", "1/3 + 1 = 4/3."]}]}], "ejemplo_completo": {"titulo": "Potencia y cuenta", "planteo": "Resolvé 1/2 + (1/3)² × 3.", "pasos": ["(1/3)² = 1/9.", "1/9 × 3 = 3/9 = 1/3.", "1/2 + 1/3 = 5/6."]}, "ejemplo_incompleto": {"titulo": "Completá", "planteo": "Completá (2/3)².", "pasos": ["Se eleva el numerador: 2² = ___ .", "Se eleva el denominador: 3² = 9.", "(2/3)² = 4/9."]}, "ejemplo_solo": {"titulo": "tu turno", "planteo": "Resolvé (1/2)³ + 1/4 y (−2/3)². Explicá cómo decidiste el signo."}, "tip": {"titulo": "Exponente y signo", "texto": "Exponente par, resultado positivo. Exponente impar, el signo de la base."}, "ojo": ["Calcular (1/2)² como 1/2 × 2 = 1.", "Olvidar elevar el denominador."], "resumen": [{"titulo": "Potencia", "texto": "Se eleva arriba y abajo."}, {"titulo": "Par", "texto": "Resultado positivo."}, {"titulo": "Impar", "texto": "Conserva el signo."}, {"titulo": "Paréntesis", "texto": "Va primero."}], "glosario": [{"palabra": "Base", "significado": "Número que se multiplica por sí mismo."}, {"palabra": "Exponente", "significado": "Dice cuántas veces."}, {"palabra": "Par", "significado": "Divisible por 2."}, {"palabra": "Impar", "significado": "No divisible por 2."}], "carpeta": ["¿Cuánto es (2/3)²? Escribilo como fracción.", "¿Cuánto es (−1/2)³? Escribilo como fracción.", "¿Cuánto es (1/2 + 1/4)²? Escribilo como fracción.", "Un compañero calculó (1/2)² como 1/2 × 2 = 1. ¿Cuál es el resultado correcto?"], "carpeta_nivel": ["aplicar", "aplicar", "aplicar", "error"], "respuestas_carpeta": [["4/9"], ["-1/8", "−1/8"], ["9/16"], ["1/4"]], "soluciones": {"incompleto": "4.", "solo": "(1/2)³ + 1/4 = 1/8 + 2/8 = 3/8. (−2/3)² = 4/9, positivo por exponente par.", "carpeta": ["4/9.", "−1/8.", "9/16.", "1/4: se eleva arriba y abajo."]}}, "4": {"objetivo": "Vas a resolver problemas que combinan fracciones, decimales y varias operaciones, planteando cada paso.", "vas_a_ver": ["Leer y plantear", "Fracción de una cantidad", "Partes sucesivas", "Verificar el resultado"], "secciones": [{"etapa": 1, "titulo": "Leer y plantear", "bloques": [{"tipo": "parrafo", "texto": "Para resolver un problema se lee, se detecta <b>de qué cantidad</b> se toma cada parte, se plantea la cuenta y se resuelve <b>en orden</b>."}, {"tipo": "importante", "titulo": "Idea clave", "texto": "«1/3 de 90» se calcula multiplicando: 1/3 × 90."}]}, {"etapa": 1, "titulo": "Fracción de una cantidad", "bloques": [{"tipo": "ejemplo", "titulo": "Un tanque de 120 L", "texto": "Se usa 1/3 el lunes y 1/4 del resto el martes.", "items": ["Lunes: 1/3 de 120 = 40 L. Quedan 80 L.", "Martes: 1/4 de 80 = 20 L.", "Quedan 120 − 40 − 20 = 60 L."]}]}, {"etapa": 2, "titulo": "Repartir en partes iguales", "bloques": [{"tipo": "ejemplo", "titulo": "Una cinta de 3/4 m", "texto": "Se corta en 3 partes iguales.", "items": ["Se divide 3/4 ÷ 3.", "3/4 ÷ 3 = 3/12 = 1/4.", "Cada parte mide 1/4 m."]}]}, {"etapa": 2, "titulo": "Verificar", "bloques": [{"tipo": "parrafo", "texto": "Al final se comprueba que el resultado tenga sentido: si se usó una parte de un total, lo que queda tiene que ser menor que el total."}]}], "ejemplo_completo": {"titulo": "Partes sucesivas", "planteo": "De 60 figuritas se regala 1/4 y después 1/3 de las que quedan. ¿Cuántas quedan?", "pasos": ["1/4 de 60 = 15. Quedan 45.", "1/3 de 45 = 15.", "Quedan 45 − 15 = 30 figuritas."]}, "ejemplo_incompleto": {"titulo": "Completá", "planteo": "Completá.", "pasos": ["1/5 de 50 = ___ .", "Quedan 50 − 10 = 40.", "1/4 de lo que queda es 10."]}, "ejemplo_solo": {"titulo": "tu turno", "planteo": "Un tanque de 90 L se usa 1/3 el lunes y 1/5 del resto el martes. ¿Cuántos litros quedan? Mostrá cada paso."}, "tip": {"titulo": "De lo que queda", "texto": "«Del resto» significa que la segunda fracción se calcula sobre lo que quedó, no sobre el total."}, "ojo": ["Calcular la segunda fracción sobre el total y no sobre el resto.", "Dividir por la fracción en lugar de multiplicar: 1/3 de 90 no es 90 ÷ 1/3."], "resumen": [{"titulo": "De una cantidad", "texto": "Se multiplica."}, {"titulo": "Del resto", "texto": "Sobre lo que queda."}, {"titulo": "Partes iguales", "texto": "Se divide."}, {"titulo": "Verificar", "texto": "El resultado tiene que tener sentido."}], "glosario": [{"palabra": "Resto", "significado": "Lo que queda."}, {"palabra": "Parte", "significado": "Fracción de un total."}, {"palabra": "Reparto", "significado": "Dividir en partes iguales."}, {"palabra": "Plantear", "significado": "Escribir la cuenta del problema."}], "carpeta": ["Un tanque tiene 90 L y se usa 1/3. ¿Cuántos litros quedan?", "Se reparten 3/4 kg de harina en 3 partes iguales. ¿Cuánto es cada parte? Escribilo como fracción.", "De 80 alumnos, 1/4 va a un taller y 1/5 de los que quedan, a otro. ¿Cuántos van al segundo taller?", "Un compañero calculó 1/3 de 90 como 90 ÷ 1/3 = 270. ¿Cuál es el resultado correcto?"], "carpeta_nivel": ["aplicar", "aplicar", "aplicar", "error"], "respuestas_carpeta": [["60"], ["1/4"], ["12"], ["30"]], "soluciones": {"incompleto": "10.", "solo": "1/3 de 90 = 30. Quedan 60. 1/5 de 60 = 12. Quedan 48 L.", "carpeta": ["60.", "1/4.", "12.", "30: se multiplica 1/3 × 90."]}}}, "act": {"1": [{"t": "short_answer", "p": "Calculá 1/2 + 1/3 × 3/4. Escribilo como fracción.", "o": {}, "r": {"acepta": ["3/4"]}, "e": "Primero la multiplicación: 1/4. Después 1/2 + 1/4.", "n": "aplicar"}, {"t": "multiple_choice", "p": "¿Qué se resuelve primero en 2/3 + 1/2 × 1/4?", "o": ["La suma", "La multiplicación", "Da lo mismo"],