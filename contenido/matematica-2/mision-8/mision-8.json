{"subject_id": "0b36ea19-5877-4077-a8bd-c62313d37658", "tema": 8, "practica": "Práctica general: ecuaciones de primer grado", "examen_titulo": "Nivel jefe: ecuaciones de primer grado", "niveles": {"1": {"objetivo": "Vas a resolver ecuaciones con paréntesis aplicando la propiedad distributiva y despejando la incógnita.", "vas_a_ver": ["Quitar los paréntesis", "Agrupar y despejar", "Resolver paso a paso", "Controlar los signos"], "secciones": [{"etapa": 1, "titulo": "Ecuaciones con paréntesis", "bloques": [{"tipo": "definicion", "titulo": "Ecuación con paréntesis", "texto": "Primero se <b>aplica la propiedad distributiva</b> para quitar los paréntesis y después se despeja la incógnita."}, {"tipo": "importante", "titulo": "Idea clave", "texto": "2(x + 3) = 14 se transforma en 2x + 6 = 14."}]}, {"etapa": 1, "titulo": "Sin paréntesis", "bloques": [{"tipo": "tabla", "titulo": "Distribuir", "columnas": ["Ecuación", "Sin paréntesis"], "filas": [["2(x + 3) = 14", "2x + 6 = 14"], ["3(x − 1) = 12", "3x − 3 = 12"], ["4(x + 1) = 20", "4x + 4 = 20"]], "iguales": true}]}, {"etapa": 2, "titulo": "Un ejemplo", "bloques": [{"tipo": "ejemplo", "titulo": "Resolver 2(x + 3) = 14", "texto": "Se distribuye y se despeja.", "items": ["2x + 6 = 14.", "2x = 8.", "x = 4."]}]}, {"etapa": 2, "titulo": "Con resta", "bloques": [{"tipo": "ejemplo", "titulo": "Resolver 3(x − 1) = 12", "texto": "Se distribuye el 3 también sobre el signo menos.", "items": ["3x − 3 = 12.", "3x = 15.", "x = 5."]}]}], "ejemplo_completo": {"titulo": "Distribuir y despejar", "planteo": "Resolvé 2(x + 3) = 14.", "pasos": ["Se distribuye: 2x + 6 = 14.", "Se resta 6: 2x = 8.", "Se divide por 2: x = 4."]}, "ejemplo_incompleto": {"titulo": "Completá", "planteo": "Resolvé 3(x − 1) = 12.", "pasos": ["Se distribuye: 3x − 3 = 12.", "Se suma 3: 3x = ___ .", "x = 5."]}, "ejemplo_solo": {"titulo": "tu turno", "planteo": "Resolvé 4(x + 3) = 24 y comprobá el resultado."}, "tip": {"titulo": "Distribuir todo", "texto": "El número de afuera multiplica a todos los términos del paréntesis, también al que tiene signo menos."}, "ojo": ["Multiplicar solo el primer término del paréntesis.", "Olvidar el signo menos al distribuir."], "resumen": [{"titulo": "Distributiva", "texto": "El número de afuera multiplica a cada término."}, {"titulo": "Despejar", "texto": "Pasar los términos para dejar sola la x."}, {"titulo": "Operación inversa", "texto": "Se deshace con la contraria."}, {"titulo": "Comprobar", "texto": "Reemplazar x en la ecuación."}], "glosario": [{"palabra": "Ecuación", "significado": "Igualdad con una incógnita."}, {"palabra": "Incógnita", "significado": "Valor que hay que hallar."}, {"palabra": "Miembro", "significado": "Cada lado de la igualdad."}, {"palabra": "Distribuir", "significado": "Multiplicar por cada término."}], "carpeta": ["Resolvé 2(x + 3) = 14. ¿Cuánto vale x?", "Resolvé 3(x − 1) = 12. ¿Cuánto vale x?", "Resolvé 4(x + 3) = 24. ¿Cuánto vale x?", "Un compañero resolvió 2(x + 3) = 14 como 2x + 3 = 14. ¿Cuánto vale x en realidad?"], "carpeta_nivel": ["aplicar", "aplicar", "aplicar", "error"], "respuestas_carpeta": [["4"], ["5"], ["3"], ["4"]], "soluciones": {"incompleto": "5.", "solo": "4x + 12 = 24, 4x = 12, x = 3.", "carpeta": ["4.", "5.", "3.", "4: el 2 multiplica también al 3."]}}, "2": {"objetivo": "Vas a resolver ecuaciones con denominadores multiplicando ambos miembros por el mínimo común múltiplo.", "vas_a_ver": ["Quitar denominadores", "El mínimo común múltiplo", "Resolver ecuaciones", "Comprobar"], "secciones": [{"etapa": 1, "titulo": "Denominadores", "bloques": [{"tipo": "definicion", "titulo": "Ecuación con denominadores", "texto": "Para quitar los denominadores se <b>multiplican ambos miembros por el mínimo común múltiplo</b> de los denominadores."}, {"tipo": "importante", "titulo": "Idea clave", "texto": "x/2 = 6 se resuelve multiplicando por 2: x = 12."}]}, {"etapa": 1, "titulo": "Ejemplos", "bloques": [{"tipo": "tabla", "titulo": "Multiplicar por el mcm", "columnas": ["Ecuación", "Se multiplica por", "Resultado"], "filas": [["x/2 = 6", "2", "x = 12"], ["x/3 + 1 = 5", "3", "x = 12"], ["x/2 + x/3 = 5", "6", "x = 6"]], "iguales": true}]}, {"etapa": 2, "titulo": "Un denominador", "bloques": [{"tipo": "ejemplo", "titulo": "Resolver x/3 + 1 = 5", "texto": "Primero se resta 1 y después se multiplica.", "items": ["Se resta 1: x/3 = 4.", "Se multiplica por 3.", "x = 12."]}]}, {"etapa": 2, "titulo": "Dos denominadores", "bloques": [{"tipo": "ejemplo", "titulo": "Resolver x/2 + x/3 = 5", "texto": "El mcm de 2 y 3 es 6.", "items": ["Se multiplica por 6: 3x + 2x = 30.", "5x = 30.", "x = 6."]}]}], "ejemplo_completo": {"titulo": "Quitar el denominador", "planteo": "Resolvé x/3 + 1 = 5.", "pasos": ["Se resta 1: x/3 = 4.", "Se multiplica por 3.", "x = 12."]}, "ejemplo_incompleto": {"titulo": "Completá", "planteo": "Resolvé x/2 + x/3 = 5.", "pasos": ["Se multiplica por 6: 3x + 2x = 30.", "5x = 30, entonces x = ___ .", "x = 6."]}, "ejemplo_solo": {"titulo": "tu turno", "planteo": "Resolvé x/5 + 2 = 6 y x/2 + x/4 = 6."}, "tip": {"titulo": "Multiplicar todo", "texto": "Cuando multiplicás por el mcm, multiplicá todos los términos de los dos miembros, no solo los que tienen denominador."}, "ojo": ["Multiplicar solo la fracción por el mcm.", "Sumar los denominadores como si fueran números."], "resumen": [{"titulo": "mcm", "texto": "Mínimo común múltiplo de los denominadores."}, {"titulo": "Multiplicar", "texto": "Todos los términos por el mcm."}, {"titulo": "Despejar", "texto": "Dejar sola la x."}, {"titulo": "Comprobar", "texto": "Reemplazar en la ecuación original."}], "glosario": [{"palabra": "Denominador", "significado": "Número de abajo de la fracción."}, {"palabra": "mcm", "significado": "Menor múltiplo común."}, {"palabra": "Miembro", "significado": "Lado de la igualdad."}, {"palabra": "Término", "significado": "Cada sumando de la ecuación."}], "carpeta": ["Resolvé x/2 = 6. ¿Cuánto vale x?", "Resolvé x/5 + 2 = 6. ¿Cuánto vale x?", "Resolvé x/2 + x/3 = 5. ¿Cuánto vale x?", "Un compañero sumó x/2 + x/4 como 2x/6. Resolvé x/2 + x/4 = 6 bien. ¿Cuánto vale x?"], "carpeta_nivel": ["aplicar", "aplicar", "aplicar", "error"], "respuestas_carpeta": [["12"], ["20"], ["6"], ["8"]], "soluciones": {"incompleto": "6.", "solo": "x/5 = 4, entonces x = 20. Con x/2 + x/4 = 6 se multiplica por 4: 2x + x = 24, x = 8.", "carpeta": ["12.", "20.", "6.", "8: el mcm es 4, no se suman los denominadores."]}}, "3": {"objetivo": "Vas a reconocer ecuaciones sin solución, con una solución y con infinitas soluciones (identidades).", "vas_a_ver": ["Una, ninguna o infinitas", "Sin solución", "Identidades", "Cómo decidir"], "secciones": [{"etapa": 1, "titulo": "Tres casos", "bloques": [{"tipo": "definicion", "titulo": "Sin solución e identidad", "texto": "Si al despejar queda una igualdad falsa, como 3 = 5, la ecuación <b>no tiene solución</b>. Si queda siempre verdadera, como 4 = 4, es una <b>identidad</b> con infinitas soluciones."}, {"tipo": "importante", "titulo": "Idea clave", "texto": "x + 1 = x + 2 no tiene solución; 2x = x + x es una identidad."}]}, {"etapa": 1, "titulo": "Clasificar", "bloques": [{"tipo": "tabla", "titulo": "Los tres casos", "columnas": ["Ecuación", "Queda", "Tipo"], "filas": [["x + 1 = x + 2", "1 = 2", "Sin solución"], ["2x + 4 = 2(x + 2)", "4 = 4", "Identidad"], ["3x = x + 4", "x = 2", "Una solución"]], "iguales": true}]}, {"etapa": 2, "titulo": "Sin solución", "bloques": [{"tipo": "ejemplo", "titulo": "Resolver 2x + 3 = 2x + 5", "texto": "Se resta 2x en ambos miembros.", "items": ["Se resta 2x: 3 = 5.", "Esa igualdad es falsa.", "La ecuación no tiene solución."]}]}, {"etapa": 2, "titulo": "Identidad", "bloques": [{"tipo": "ejemplo", "titulo": "Resolver 3(x + 1) = 3x + 3", "texto": "Se distribuye y se compara.", "items": ["3x + 3 = 3x + 3.", "Se resta 3x: 3 = 3.", "Siempre es verdadera: es una identidad."]}]}], "ejemplo_completo": {"titulo": "Sin solución", "planteo": "Resolvé 2x + 3 = 2x + 5.", "pasos": ["Se resta 2x en los dos miembros.", "Queda 3 = 5, que es falso.", "No tiene solución."]}, "ejemplo_incompleto": {"titulo": "Completá", "planteo": "Resolvé 3x = x + 4.", "pasos": ["Se resta x: 2x = 4.", "x = ___ .", "La solución es 2."]}, "ejemplo_solo": {"titulo": "tu turno", "planteo": "Resolvé 4x + 2 = 2x + 10 y 5x − 3 = 3x + 7."}, "tip": {"titulo": "Mirar el final", "texto": "Después de despejar, mirá cómo queda: una igualdad falsa, siempre verdadera, o un valor para x."}, "ojo": ["Decir que x vale 1 cuando queda 3 = 5.", "Confundir identidad con ecuación sin solución."], "resumen": [{"titulo": "Sin solución", "texto": "Queda una igualdad falsa."}, {"titulo": "Identidad", "texto": "Queda una igualdad siempre verdadera."}, {"titulo": "Una solución", "texto": "Queda x igual a un número."}, {"titulo": "Decidir", "texto": "Mirar cómo queda al despejar."}], "glosario": [{"palabra": "Sin solución", "significado": "Ningún valor cumple la ecuación."}, {"palabra": "Identidad", "significado": "Todos los valores la cumplen."}, {"palabra": "Igualdad falsa", "significado": "Por ejemplo 3 = 5."}, {"palabra": "Igualdad verdadera", "significado": "Por ejemplo 4 = 4."}], "carpeta": ["Resolvé 3x = x + 4. ¿Cuánto vale x?", "Resolvé 4x + 2 = 2x + 10. ¿Cuánto vale x?", "Resolvé 5x − 3 = 3x + 7. ¿Cuánto vale x?", "Un compañero dijo que 2x + 3 = 2x + 5 tiene solución x = 1. ¿Cuántas soluciones tiene en realidad? Escribí 0 si ninguna."], "carpeta_nivel": ["aplicar", "aplicar", "aplicar", "error"], "respuestas_carpeta": [["2"], ["4"], ["5"], ["0"]], "soluciones": {"incompleto": "2.", "solo": "4x + 2 = 2x + 10 da x = 4 y 5x − 3 = 3x + 7 da x = 5.", "carpeta": ["2.", "4.", "5.", "0: queda 3 = 5, que es falso."]}}, "4": {"objetivo": "Vas a verificar si un valor es solución de una ecuación reemplazándolo y a escribir la solución completa.", "vas_a_ver": ["Reemplazar el valor", "Comparar los dos miembros", "Escribir la solución", "Detectar errores"], "secciones": [{"etapa": 1, "titulo": "Verificar", "bloques": [{"tipo": "definicion", "titulo": "Verificar una solución", "texto": "Para comprobar una solución se <b>reemplaza el valor en la ecuación</b> original: si los dos miembros dan lo mismo, la solución es correcta."}, {"tipo": "importante", "titulo": "Idea clave", "texto": "Si x = 4 en 2x + 1 = 9, entonces 2 · 4 + 1 = 9: es correcto."}]}, {"etapa": 1, "titulo": "Ejemplos", "bloques": [{"tipo": "tabla", "titulo": "¿Verifica?", "columnas": ["Ecuación", "Valor", "¿Verifica?"], "filas": [["2x + 1 = 9", "x = 4", "Sí"], ["3x − 2 = 10", "x = 5", "No"], ["x/2 + 1 = 4", "x = 6", "Sí"]], "iguales": true}]}, {"etapa": 2, "titulo": "Sí verifica", "bloques": [{"tipo": "ejemplo", "titulo": "Verificar x = 4 en 2x + 1 = 9", "texto": "Se reemplaza y se calcula.", "items": ["2 · 4 + 1.", "8 + 1 = 9.", "Los dos miembros coinciden: es solución."]}]}, {"etapa": 2, "titulo": "No verifica", "bloques": [{"tipo": "ejemplo", "titulo": "Verificar x = 5 en 3x − 2 = 10", "texto": "Se reemplaza y se calcula.", "items": ["3 · 5 − 2.", "15 − 2 = 13.", "13 no es 10: no es solución."]}]}], "ejemplo_completo": {"titulo": "Reemplazar", "planteo": "Verificá si x = 4 es solución de 2x + 1 = 9.", "pasos": ["Se reemplaza: 2 · 4 + 1.", "8 + 1 = 9.", "Coincide con 9: sí es solución."]}, "ejemplo_incompleto": {"titulo": "Completá", "planteo": "Verificá si x = 6 es solución de x/2 + 1 = 4.", "pasos": ["Se reemplaza: 6 / 2 + 1.", "3 + 1 = ___ .", "Coincide con 4: sí es solución."]}, "ejemplo_solo": {"titulo": "tu turno", "planteo": "Resolvé 3x − 2 = 10 y verificá tu respuesta."}, "tip": {"titulo": "Siempre comprobá", "texto": "Reemplazar el valor en la ecuación original te avisa si te equivocaste al despejar."}, "ojo": ["Reemplazar en la ecuación ya transformada y no en la original.", "Dar por buena la solución sin comprobar."], "resumen": [{"titulo": "Verificar", "texto": "Reemplazar el valor en la ecuación original."}, {"titulo": "Coinciden", "texto": "Los dos miembros dan lo mismo."}, {"titulo": "No c