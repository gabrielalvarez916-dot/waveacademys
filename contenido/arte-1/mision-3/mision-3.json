ios", "Monocromática"], "derecha": ["Rojo, naranja y amarillo", "Azul, verde y violeta", "Enfrentados en el círculo", "Un solo color con sus tonos"]}, "r": {"pares": {"Cálidos": "Rojo, naranja y amarillo", "Fríos": "Azul, verde y violeta", "Complementarios": "Enfrentados en el círculo", "Monocromática": "Un solo color con sus tonos"}}, "e": "Cada término, su definición."}, {"t": "true_false", "p": "Los colores cálidos parecen acercarse.", "o": ["Verdadero", "Falso"], "r": {"correcta": "Verdadero"}, "e": "Dan sensación de cercanía."}], "3": [{"t": "multi_select", "p": "¿Qué pueden influir en el significado de un color?", "o": ["La cultura", "La época", "El contexto", "El tamaño del lápiz"], "r": {"correctas": ["La cultura", "La época", "El contexto"]}, "e": "El tamaño del lápiz no cambia el significado."}, {"t": "fill_blank", "p": "El significado que una comunidad le da a un color es su valor ___ .", "o": [], "r": {"huecos": [["simbolico", "simbólico"]]}, "e": "Es lo que representa."}], "4": [{"t": "ordering", "p": "Ordená los pasos para armar una paleta.", "o": ["Acento", "Propósito", "Apoyos", "Dominante"], "r": {"orden": ["Propósito", "Dominante", "Apoyos", "Acento"]}, "e": "De la idea al detalle."}, {"t": "tap_text", "p": "Tocá el color que ocupa más lugar: «El dominante ocupa más de la mitad».", "o": {"segmentos": ["El", "dominante", "ocupa", "más", "de", "la", "mitad."], "modo": "palabras"}, "r": {"tocar": [1]}, "e": "El dominante es el principal."}], "5": [{"t": "classify", "p": "Cálido o frío.", "o": {"elementos": ["Rojo", "Azul", "Amarillo", "Violeta"], "categorias": ["Cálido", "Frío"]}, "r": {"categorias": {"Rojo": "Cálido", "Azul": "Frío", "Amarillo": "Cálido", "Violeta": "Frío"}}, "e": "Cada color tiene su temperatura.", "tiempo": 30}, {"t": "fill_blank", "p": "El color que sale de mezclar amarillo y azul es el ___ .", "o": [], "r": {"huecos": [["verde"]]}, "e": "Es un secundario.", "tiempo": 20}, {"t": "true_false", "p": "Un color significa lo mismo en t