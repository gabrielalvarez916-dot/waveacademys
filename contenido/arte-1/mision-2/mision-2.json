{"subject_id": "825b1d79-1ef4-47ee-999d-6b5bbc1080da", "tema": 2, "practica": "Práctica general: dibujar lo que vemos", "examen_titulo": "Nivel jefe: dibujar lo que vemos", "niveles": {"1": {"objetivo": "Vas a dibujar un objeto observándolo, yendo de la forma general al detalle.", "vas_a_ver": ["Dibujar mirando", "De lo general a lo particular", "Medir con la mirada", "Contorno y detalle"], "secciones": [{"etapa": 1, "titulo": "Dibujar mirando", "bloques": [{"tipo": "definicion", "titulo": "Dibujo de observación", "texto": "Dibujo hecho mirando un objeto real, para representarlo tal como se ve y no como se imagina."}, {"tipo": "parrafo", "texto": "Los símbolos que dibujamos de memoria, como un sol con rayos o una casa de techo triangular, nos engañan. Al observar, el dibujo se parece más al objeto real."}]}, {"etapa": 1, "titulo": "De lo general a lo particular", "bloques": [{"tipo": "tabla", "titulo": "Pasos del dibujo de observación", "columnas": ["Paso", "Qué se hace"], "filas": [["1. Encajar", "Marcar con trazos suaves el tamaño y la posición total del objeto"], ["2. Estructura", "Dibujar las formas simples que lo componen"], ["3. Contorno", "Afinar el borde con líneas más firmes"], ["4. Detalle", "Sumar texturas y marcas pequeñas"]], "iguales": true}]}, {"etapa": 2, "titulo": "Medir con la mirada", "bloques": [{"tipo": "parrafo", "texto": "Se pueden comparar tamaños con el lápiz extendido: se cierra un ojo, se toma una medida del objeto y se la compara con otras partes. Así se controla la proporción sin usar regla."}, {"tipo": "importante", "titulo": "Trazo suave primero", "texto": "Los trazos de encaje son suaves para poder corregir."}]}, {"etapa": 2, "titulo": "Contorno y detalle", "bloques": [{"tipo": "tabla", "titulo": "Dos tipos de línea", "columnas": ["Línea", "Para qué sirve"], "filas": [["Contorno", "Marca el borde del objeto"], ["Detalle", "Muestra texturas, marcas y relieves"]], "iguales": true}, {"tipo": "parrafo", "texto": "Un contorno de grosor variable, más grueso donde hay sombra o donde el objeto está más cerca, da sensación de volumen."}]}], "ejemplo_completo": {"titulo": "dibujar", "planteo": "Vas a dibujar una taza. ¿Cómo se aplican los cuatro pasos?", "pasos": ["Encajar: un rectángulo suave que cubre toda la taza.", "Estructura: un cilindro y un óvalo arriba para la boca.", "Contorno: afinar el borde y agregar el asa.", "Detalle: marcar el brillo y las manchas."]}, "ejemplo_incompleto": {"titulo": "completar", "planteo": "Completá.", "pasos": ["Dibujar mirando un objeto real es un dibujo de ___ .", "Los trazos del primer paso, para poder corregir, son ___ ."]}, "ejemplo_solo": {"titulo": "tu turno", "planteo": "Elegí un objeto pequeño y dibujalo siguiendo los cuatro pasos. Escribí qué paso te costó más."}, "tip": {"titulo": "Dibujá lo que ves", "texto": "Dibujá lo que ves y no lo que creés que es: mirá más tiempo el objeto que la hoja."}, "ojo": ["Empezar por los detalles antes de encajar el objeto.", "Dibujar de memoria en vez de mirar."], "resumen": [{"titulo": "Observación", "texto": "Dibujar mirando."}, {"titulo": "Pasos", "texto": "Encajar, estructura, contorno, detalle."}, {"titulo": "Medir", "texto": "Con el lápiz extendido."}, {"titulo": "Trazo", "texto": "Suave al principio."}], "glosario": [{"palabra": "Encaje", "significado": "Primer esquema general del objeto."}, {"palabra": "Estructura", "significado": "Formas simples que componen algo."}, {"palabra": "Contorno", "significado": "Borde del objeto."}, {"palabra": "Proporción", "significado": "Relación de tamaños."}], "carpeta": ["¿Cómo se llama el dibujo hecho mirando un objeto real?", "¿Cómo se llama el primer paso, en el que se marca el tamaño total del objeto?", "¿Conviene empezar por los detalles? Respondé sí o no.", "¿Conviene que los trazos de encaje sean suaves? Respondé sí o no."], "respuestas_carpeta": [["dibujo de observacion", "dibujo de observación", "observacion", "observación"], ["encaje", "encajar", "el encaje"], ["no"], ["si", "sí"]], "soluciones": {"incompleto": "Observación. Suaves.", "solo": "Dibujé un vaso: encajé un rectángulo, marqué un cilindro, afiné el borde y sumé el brillo. Me costó más la estructura.", "carpeta": ["Dibujo de observación.", "Encaje.", "No.", "Sí."]}}, "2": {"objetivo": "Vas a representar el volumen de un objeto con luz y sombra.", "vas_a_ver": ["La fuente de luz", "Partes de la sombra", "Claroscuro y volumen", "Valores"], "secciones": [{"etapa": 1, "titulo": "La fuente de luz", "bloques": [{"tipo": "definicion", "titulo": "Fuente de luz", "texto": "Lugar de donde viene la luz; define qué zonas se iluminan y cuáles quedan en sombra."}, {"tipo": "parrafo", "texto": "Antes de sombrear hay que decidir de dónde viene la luz y mantenerla igual en todo el dibujo."}]}, {"etapa": 1, "titulo": "Partes de la sombra", "bloques": [{"tipo": "tabla", "titulo": "Zonas de un objeto iluminado", "columnas": ["Zona", "Qué es"], "filas": [["Luz", "Zona más clara, la que mira a la fuente"], ["Sombra propia", "Zona del objeto que no recibe luz"], ["Sombra proyectada", "Sombra que el objeto deja sobre el piso"], ["Luz reflejada", "Brillo suave dentro de la sombra"]], "iguales": true}]}, {"etapa": 2, "titulo": "Claroscuro y volumen", "bloques": [{"tipo": "definicion", "titulo": "Claroscuro", "texto": "Contraste entre zonas claras y oscuras que da sensación de volumen."}, {"tipo": "parrafo", "texto": "Un círculo plano se convierte en una esfera cuando se le agrega un degradé de luz a sombra."}, {"tipo": "imagen", "imagen_tipo": "diagrama", "titulo": "Las zonas de la luz y la sombra", "texto": "Una esfera iluminada desde arriba a la izquierda.", "imagen_descripcion": "Una esfera sombreada, con la luz llegando desde arriba a la izquierda. Se señalan la luz, la sombra propia en el lado opuesto, la sombra proyectada sobre el piso y un brillo suave de luz reflejada en el borde de la sombra.", "imagen_fuente": "Dibujo propio (matplotlib).", "png_base64": ""}]}, {"etapa": 2, "titulo": "Valores", "bloques": [{"tipo": "parrafo", "texto": "Los valores son los distintos tonos de gris, del más claro al más oscuro. Se logran apretando más o menos el lápiz o superponiendo capas. Un buen dibujo usa una escala de valores amplia."}, {"tipo": "importante", "titulo": "Pasá de a poco", "texto": "Oscurecé en capas: es más fácil oscurecer que aclarar."}]}], "ejemplo_completo": {"titulo": "sombrear", "planteo": "Vas a sombrear una esfera. ¿Cómo se ubican la luz y las sombras?", "pasos": ["Decidir que la luz viene de arriba a la izquierda.", "La zona más clara va arriba a la izquierda.", "La sombra propia va abajo a la derecha.", "La sombra proyectada cae del lado opuesto a la luz."]}, "ejemplo_incompleto": {"titulo": "completar", "planteo": "Completá.", "pasos": ["El contraste entre zonas claras y oscuras que da volumen es el ___ .", "La sombra que un objeto deja sobre el piso es la sombra ___ ."]}, "ejemplo_solo": {"titulo": "tu turno", "planteo": "Dibujá una esfera con una fuente de luz a tu elección y marcá la luz, la sombra propia y la sombra proyectada."}, "tip": {"titulo": "Una sola luz", "texto": "Elegí una única fuente de luz y no la cambies durante el dibujo."}, "ojo": ["Cambiar de lugar la fuente de luz a mitad del dibujo.", "Dibujar la sombra proyectada del mismo lado que la luz."], "resumen": [{"titulo": "Luz", "texto": "Define zonas claras y oscuras."}, {"titulo": "Sombras", "texto": "Propia y proyectada."}, {"titulo": "Claroscuro", "texto": "Contraste que da volumen."}, {"titulo": "Valores", "texto": "Tonos de gris."}], "glosario": [{"palabra": "Volumen", "significado": "Sensación de tres dimensiones."}, {"palabra": "Claroscuro", "significado": "Contraste de luz y sombra."}, {"palabra": "Degradé", "significado": "Paso gradual de claro a oscuro."}, {"palabra": "Valor", "significado": "Tono de claro a oscuro."}], "carpeta": ["¿Cómo se llama el contraste entre zonas claras y oscuras que da sensación de volumen?", "¿Cómo se llama la sombra que el objeto deja sobre el piso?", "¿La sombra proyectada cae del lado opuesto a la luz? Respondé sí o no.", "¿Conviene cambiar de lugar la fuente de luz a mitad del dibujo? Respondé sí o no."], "respuestas_carpeta": [["claroscuro", "el claroscuro"], ["sombra proyectada", "proyectada", "la sombra proyectada"], ["si", "sí"], ["no"]], "soluciones": {"incompleto": "Claroscuro. Proyectada.", "solo": "Luz arriba a la izquierda: zona clara arriba a la izquierda, sombra propia abajo a la derecha y sombra proyectada hacia la derecha sobre el piso.", "carpeta": ["Claroscuro.", "Sombra proyectada.", "Sí.", "No."]}}, "3": {"objetivo": "Vas a comparar proporciones y dibujar objetos con perspectiva de un punto de fuga.", "vas_a_ver": ["Proporción", "Medir y comparar", "Perspectiva", "Punto de fuga y horizonte"], "secciones": [{"etapa": 1, "titulo": "Proporción", "bloques": [{"tipo": "definicion", "titulo": "Proporción", "texto": "Relación de tamaño entre las partes de un objeto o entre varios objetos."}, {"tipo": "parrafo", "texto": "Por ejemplo, en un rostro los ojos están a la mitad de la altura de la cabeza. Conocer las proporciones ayuda a que un dibujo se vea creíble."}]}, {"etapa": 1, "titulo": "Medir y comparar", "bloques": [{"tipo": "tabla", "titulo": "Cómo controlar proporciones", "columnas": ["Método", "Cómo se hace"], "filas": [["Unidad de medida", "Elegir una parte como unidad, por ejemplo el ancho de la cabeza"], ["Comparar", "Ver cuántas veces entra esa unidad en el resto"], ["Alinear", "Verificar con líneas imaginarias horizontales y verticales"]], "iguales": true}]}, {"etapa": 2, "titulo": "Perspectiva", "bloques": [{"tipo": "definicion", "titulo": "Perspectiva", "texto": "Técnica para representar el espacio y la profundidad sobre una superficie plana."}, {"tipo": "parrafo", "texto": "Los objetos se ven más pequeños cuanto más lejos están, y las líneas paralelas parecen juntarse en el horizonte."}]}, {"etapa": 2, "titulo": "Punto de fuga y horizonte", "bloques": [{"tipo": "tabla"