{"subject_id": "825b1d79-1ef4-47ee-999d-6b5bbc1080da", "tema": 1, "practica": "Práctica general: aprender a mirar", "examen_titulo": "Nivel jefe: aprender a mirar", "niveles": {"1": {"objetivo": "Vas a distinguir ver, observar y apreciar, y practicar una mirada atenta.", "vas_a_ver": ["Ver y observar", "Apreciar", "Tres niveles de la mirada", "Entrenar la mirada"], "secciones": [{"etapa": 1, "titulo": "Ver y observar", "bloques": [{"tipo": "definicion", "titulo": "Ver", "texto": "Percibir con los ojos de manera automática, sin esfuerzo ni atención."}, {"tipo": "definicion", "titulo": "Observar", "texto": "Mirar con atención y con un propósito: buscar detalles, relaciones y diferencias."}, {"tipo": "parrafo", "texto": "Pasamos el día viendo cientos de imágenes, pero observamos muy pocas. Aprender a mirar es pasar de ver a observar."}]}, {"etapa": 1, "titulo": "Apreciar", "bloques": [{"tipo": "definicion", "titulo": "Apreciar", "texto": "Valorar lo que se observa: reconocer qué lo hace interesante, bello, expresivo o significativo."}, {"tipo": "parrafo", "texto": "Apreciar no es solo decir si algo gusta o no: es poder explicar por qué nos llama la atención, y eso se aprende."}]}, {"etapa": 2, "titulo": "Tres niveles de la mirada", "bloques": [{"tipo": "tabla", "titulo": "De ver a apreciar", "columnas": ["Nivel", "Qué hacemos"], "filas": [["Ver", "Percibir sin pensar, por ejemplo pasar frente a un mural"], ["Observar", "Buscar detalles, por ejemplo contar los colores y las formas del mural"], ["Apreciar", "Valorar y explicar qué transmite el mural y por qué"]], "iguales": true}]}, {"etapa": 2, "titulo": "Entrenar la mirada", "bloques": [{"tipo": "tabla", "titulo": "Ejercicios para observar", "columnas": ["Ejercicio", "Cómo se hace"], "filas": [["Mirar despacio", "Dedicar un minuto entero a un solo objeto"], ["Preguntar", "¿Qué forma, color y textura tiene?"], ["Comparar", "Buscar qué cambia entre dos objetos parecidos"], ["Anotar", "Escribir o dibujar lo que se descubre"]], "iguales": true}, {"tipo": "importante", "titulo": "Mirar es una práctica", "texto": "Cuanto más se observa, más se descubre."}]}], "ejemplo_completo": {"titulo": "observar", "planteo": "Tenés una hoja de árbol en la mano. ¿Cómo pasás de verla a apreciarla?", "pasos": ["Ver: percibir que es una hoja verde.", "Observar: notar su forma, sus nervaduras y sus bordes.", "Apreciar: explicar qué la hace interesante, por ejemplo su simetría."]}, "ejemplo_incompleto": {"titulo": "completar", "planteo": "Completá.", "pasos": ["Mirar con atención y con un propósito es ___ .", "Valorar lo que se observa y explicar por qué es ___ ."]}, "ejemplo_solo": {"titulo": "tu turno", "planteo": "Elegí un objeto y miralo durante un minuto. Escribí cinco detalles que antes no habías notado."}, "tip": {"titulo": "Un minuto entero", "texto": "Mirá un solo objeto durante un minuto completo: siempre aparece algo nuevo."}, "ojo": ["Pensar que ver y observar son lo mismo.", "Creer que apreciar es solo decir si algo gusta."], "resumen": [{"titulo": "Ver", "texto": "Percibir sin atención."}, {"titulo": "Observar", "texto": "Mirar con propósito."}, {"titulo": "Apreciar", "texto": "Valorar y explicar."}, {"titulo": "Entrenar", "texto": "Mirar despacio y anotar."}], "glosario": [{"palabra": "Observar", "significado": "Mirar con atención."}, {"palabra": "Apreciar", "significado": "Valorar y explicar por qué."}, {"palabra": "Detalle", "significado": "Parte pequeña que suma sentido."}, {"palabra": "Textura", "significado": "Cómo se ve o se siente una superficie."}], "carpeta": ["¿Cómo se llama mirar con atención y con un propósito?", "¿Cómo se llama valorar lo que se observa y poder explicar por qué?", "¿Ver es lo mismo que observar? Respondé sí o no.", "¿Mirar un objeto durante un minuto entero ayuda a descubrir detalles? Respondé sí o no."], "respuestas_carpeta": [["observar", "observacion", "observación"], ["apreciar", "apreciacion", "apreciación"], ["no"], ["si", "sí"]], "soluciones": {"incompleto": "Observar. Apreciar.", "solo": "Una taza: el asa tiene una curva, hay una mancha en el borde, el esmalte brilla, la base es rugosa y las sombras son más azules.", "carpeta": ["Observar.", "Apreciar.", "No.", "Sí."]}}, "2": {"objetivo": "Vas a reconocer el punto, la línea y el plano como elementos básicos del lenguaje visual y usarlos para describir imágenes.", "vas_a_ver": ["El punto", "La línea", "El plano", "Los tres juntos"], "secciones": [{"etapa": 1, "titulo": "El punto", "bloques": [{"tipo": "definicion", "titulo": "Punto", "texto": "Marca mínima que ocupa un lugar en el espacio y atrae la mirada."}, {"tipo": "parrafo", "texto": "Un punto solo concentra la atención. Muchos puntos juntos forman texturas, sombras o imágenes enteras."}]}, {"etapa": 1, "titulo": "La línea", "bloques": [{"tipo": "definicion", "titulo": "Línea", "texto": "Recorrido de un punto en movimiento; une, separa y marca dirección."}, {"tipo": "tabla", "titulo": "Tipos de línea", "columnas": ["Tipo", "Qué transmite"], "filas": [["Recta horizontal", "Calma y estabilidad"], ["Recta vertical", "Firmeza y altura"], ["Diagonal", "Movimiento y tensión"], ["Curva", "Suavidad y fluidez"], ["Quebrada", "Inquietud y energía"]], "iguales": true}]}, {"etapa": 2, "titulo": "El plano", "bloques": [{"tipo": "definicion", "titulo": "Plano", "texto": "Superficie de dos dimensiones que se forma cuando una línea se cierra o se extiende."}, {"tipo": "parrafo", "texto": "Los planos pueden ser de color, de textura o de luz. Al superponerse crean sensación de profundidad."}, {"tipo": "imagen", "imagen_tipo": "diagrama", "titulo": "Punto, línea y plano", "texto": "Los tres elementos básicos del lenguaje visual.", "imagen_descripcion": "Tres recuadros: uno con puntos de distintos tamaños, otro con líneas rectas, curvas y quebradas, y otro con planos de color superpuestos.", "imagen_fuente": "Dibujo propio (matplotlib).", "png_base64": ""}]}, {"etapa": 2, "titulo": "Los tres juntos", "bloques": [{"tipo": "parrafo", "texto": "En una imagen casi nunca aparecen aislados: el punto marca focos de atención, las líneas guían la mirada y los planos organizan el espacio. Para analizar una imagen se puede buscar dónde hay puntos, qué líneas la recorren y cuántos planos tiene."}]}], "ejemplo_completo": {"titulo": "analizar", "planteo": "Una imagen tiene un camino diagonal que baja hacia una casita pequeña, rodeada de campo. ¿Qué elementos hay y qué transmiten?", "pasos": ["La diagonal es una línea: marca dirección y movimiento.", "La casita pequeña funciona como un punto de atención.", "El campo que la rodea es un plano que organiza el espacio."]}, "ejemplo_incompleto": {"titulo": "completar", "planteo": "Completá.", "pasos": ["Un recorrido que une, separa o marca dirección es una ___ .", "La marca mínima que atrae la mirada es el ___ ."]}, "ejemplo_solo": {"titulo": "tu turno", "planteo": "Dibujá en tu carpeta tres cuadros pequeños: uno solo con puntos, otro solo con líneas y otro solo con planos de color."}, "tip": {"titulo": "Uno por uno", "texto": "Dibujá cada elemento por separado antes de combinarlos: así se entiende qué aporta cada uno."}, "ojo": ["Creer que una línea siempre es recta.", "Pensar que un plano es solo una forma geométrica pintada."], "resumen": [{"titulo": "Punto", "texto": "Marca mínima que atrae."}, {"titulo": "Línea", "texto": "Une, separa y guía."}, {"titulo": "Plano", "texto": "Superficie de dos dimensiones."}, {"titulo": "Juntos", "texto": "Se combinan en toda imagen."}], "glosario": [{"palabra": "Punto", "significado": "Marca mínima."}, {"palabra": "Línea", "significado": "Recorrido de un punto."}, {"palabra": "Plano", "significado": "Superficie."}, {"palabra": "Profundidad", "significado": "Sensación de distancia."}], "carpeta": ["¿Cómo se llama la marca mínima que atrae la mirada?", "¿Cómo se llama el recorrido de un punto en movimiento?", "¿La línea diagonal transmite movimiento? Respondé sí o no.", "¿Los planos pueden superponerse y crear profundidad? Respondé sí o no."], "respuestas_carpeta": [["punto", "el punto"], ["linea", "línea", "la linea", "la línea"], ["si", "sí"], ["si", "sí"]], "soluciones": {"incompleto": "Línea. Punto.", "solo": "Cuadro 1: puntos que forman una textura. Cuadro 2: líneas curvas y rectas. Cuadro 3: planos de color superpuestos.", "carpeta": ["Punto.", "Línea.", "Sí.", "Sí."]}}, "3": {"objetivo": "Vas a distinguir forma y figura, y reconocer la relación entre figura y fondo en una imagen.", "vas_a_ver": ["Forma y figura", "Fondo", "Figura y fondo", "Espacio positivo y negativo"], "secciones": [{"etapa": 1, "titulo": "Forma y figura", "bloques": [{"tipo": "definicion", "titulo": "Forma", "texto": "Aspecto exterior de algo: su contorno, sin importar qué represente."}, {"tipo": "definicion", "titulo": "Figura", "texto": "Forma que reconocemos como algo concreto, por ejemplo una casa o un árbol."}, {"tipo": "tabla", "titulo": "Tipos de forma", "columnas": ["Tipo", "Ejemplo"], "filas": [["Geométrica", "Círculo, cuadrado, triángulo"], ["Orgánica", "Hoja, nube, mancha"], ["Abstracta", "Formas inventadas sin referencia real"]], "iguales": true}]}, {"etapa": 1, "titulo": "Fondo", "bloques": [{"tipo": "definicion", "titulo": "Fondo", "texto": "Zona que rodea a la figura y la hace destacar."}, {"tipo": "parrafo", "texto": "Una figura se ve por contraste con su fondo: claro sobre oscuro, grande sobre pequeño, lleno sobre vacío."}]}, {"etapa": 2, "titulo": "Figura y fondo", "bloques": [{"tipo": "parrafo", "texto": "El cerebro separa siempre lo que mira en figura y fondo. A veces se pueden invertir: en el dibujo de abajo se ve un vaso o dos rostros de perfil, según qué zona se tome como figura."}, {"tipo": "imagen", "imagen_tipo": "diagrama", "titulo": "Figura y fondo", "texto": "Una misma imagen, dos lecturas.", "imagen_descripcion": "Una zona clara central con forma de vaso entre dos zonas oscuras que dibujan dos rostros de perfil enfrentados. Se puede leer como un vaso o como dos rostros.", "imagen_fuente": "Dibujo propio (matplotlib).", "png_base64": ""}]}, {"etapa": 2, "titulo": "Espacio positivo y negativo", "bloques": [{"tipo": "tabla", "titulo": "Dos espacios", "columnas": ["Espacio", "Qué es"], "filas": [["Positivo", "El ocupado por la figura"], ["Negativo", "El espacio vacío que la rodea"]], "iguales": true}, {"tipo": "importante", "titulo": "Mirar el vacío", "texto": "Dibujar el espacio negativo ayuda a lograr contornos más precisos."}]}], "ejemplo_completo": {"titulo": "separar", "planteo": "En un afiche hay una silueta negra sobre un cielo amarillo. ¿Qué es la figura y qué es el fondo?", "pasos": ["La silueta negra es la figura.", "El cielo amarillo es el fondo.", "El contraste de color hace que la figura se destaque."]}, "ejemplo_incompleto": {"titulo": "completar", "planteo": "Completá.", "pasos": ["La zona que rodea a la figura y la hace destacar es el ___ .", "El espacio vacío que rodea a la figura es el espacio ___ ."]}, "ejemplo_solo": {"titulo": "tu turno", "planteo": "Poné un objeto frente a una pared y dibujá solo el espacio vacío que lo rodea, sin dibujar el objeto."}, "tip": {"titulo": "Invertí la mirada", "texto": "Si un dibujo te sale mal, probá a mirar y dibujar el fondo en lugar de la figura."}, "ojo": ["Pensar que el fondo no importa.", "Creer que forma y figura son lo mismo."], "resumen": [{"titulo": "Forma", "texto": "Contorno."}, {"titulo": "Figura", "texto": "Forma reconocible."}, {"titulo": "Fondo", "texto": "Rodea y hace destacar."}, {"titulo": "Espacios", "texto": "Positivo y negativo."}], "glosario": [{"palabra": "Forma", "significado": "Contorno de algo."}, {"palabra": "Figura", "significado": "Forma reconocible."}, {"palabra": "Contraste", "significado": "Diferencia que hace destacar."}, {"palabra": "Silueta", "significado": "Contorno oscuro de una figura."}], "carpeta": ["¿Cómo se llama la zona que rodea a la figura y la hace destacar?", "¿Cómo se llama el espacio vacío que rodea a la figura?", "¿Una hoja o una nube son formas orgánicas? Respondé sí o no.", "¿Una figura se destaca por contraste con su fondo? Respondé sí o no."], "respuestas_carpeta": [["fondo", "el fondo"], ["espacio negativo", "negativo", "el espacio negativo"], ["si", "sí"], ["si", "sí"]], "soluciones": {"incompleto": "Fondo. Negativo.", "solo": "Dibujé las formas vacías entre el asa y el cuerpo de la taza, y entre la taza y la pared; la taza apareció sola.", "carpeta": ["Fondo.", "Espacio negativo.", "Sí.", "Sí."]}}, "4": {"objetivo": "Vas a leer una obra siguiendo cuatro pasos: describir, analizar, interpretar y valorar.", "vas_a_ver": ["Describir", "Analizar", "Interpretar", "Valorar"], "secciones": [{"etapa": 1, "titulo": "Describir", "bloques": [{"tipo": "definicion", "titulo": "Describir", "texto": "Decir qué se ve, sin opinar: personajes, objetos, colores, lugar."}, {"tipo": "parrafo", "texto": "La descripción es objetiva: cualquier persona debería reconocer lo que se dice. Empezar describiendo evita apurar interpretaciones."}]}, {"etapa": 1, "titulo": "Analizar", "bloques": [{"tipo": "definicion", "titulo": "Analizar", "texto": "Observar cómo está hecha la obra: elementos visuales, composición, técnica y materiales."}, {"tipo": "tabla", "titulo": "Qué analizar", "columnas": ["Aspecto", "Pregunta"], "filas": [["Elementos", "¿Qué puntos, líneas y planos hay?"], ["Color", "¿Qué colores dominan?"], ["Composición", "¿Cómo se ordena lo que se ve?"], ["Técnica", "¿Con qué materiales se hizo?"]], "iguales": true}]}, {"etapa": 2, "titulo": "Interpretar", "bloques": [{"tipo": "definicion", "titulo": "Interpretar", "texto": "Proponer qué significa la obra o qué transmite, apoyándose en lo que se observó."}, {"tipo": "parrafo", "texto": "Puede haber varias interpretaciones válidas, siempre que se expliquen con pruebas visibles en la obra."}]}, {"etapa": 2, "titulo": "Valorar", "bloques": [{"tipo": "parrafo", "texto": "Valorar es dar una opinión fundamentada: qué logra la obra, qué nos provoca y por qué. «Me gusta porque…» es mejor que «me gusta» a secas."}, {"tipo": "importante", "titulo": "Cuatro pasos", "texto": "Describir, analizar, interpretar y valorar, siempre en ese orden."}]}], "ejemplo_completo": {"titulo": "leer", "planteo": "Una obra muestra una figura pequeña en un campo amplio, con colores fríos. ¿Cómo la leemos?", "pasos": ["Describir: hay una persona pequeña y un campo muy grande.", "Analizar: los colores fríos y el espacio vacío dominan la imagen.", "Interpretar: puede transmitir soledad o calma.", "Valorar: logra emoción por el contraste entre la figura y el espacio."]}, "ejemplo_incompleto": {"titulo": "completar", "planteo": "Completá.", "pasos": ["Decir qué se ve, sin opinar, es ___ .", "Proponer qué significa una obra es ___ ."]}, "ejemplo_solo": {"titulo": "tu turno", "planteo": "Elegí una imagen que tengas a mano y escribí una frase para cada paso: describir, analizar, interpretar y valorar."}, "tip": {"titulo": "Sin apuro", "texto": "No saltes a interpretar: primero describí todo lo que ves."}, "ojo": ["Interpretar sin mirar bien la obra.", "Decir solo «me gusta» sin explicar por qué."], "resumen": [{"titulo": "Describir", "texto": "Qué se ve."}, {"titulo": "Analizar", "texto": "Cómo está hecha."}, {"titulo": "Interpretar", "texto": "Qué significa."}, {"titulo": "Valorar", "texto": "Opinión fundamentada."}], "glosario": [{"palabra": "Composición", "significado": "Cómo se ordenan los elementos."}, {"palabra": "Técnica", "significado": "Modo de hacer una obra."}, {"palabra": "Interpretar", "significado": "Proponer un significado."}, {"palabra": "Fundamentar", "significado": "Dar razones."}], "carpeta": ["¿Cómo se llama el paso de decir qué se ve, sin opinar?", "¿Cómo se llama el paso de proponer qué significa la obra?", "¿Una obra puede tener varias interpretaciones válidas? Respondé sí o no.", "¿Conviene que una opinión esté fundamentada? Respondé sí o no."], "respuestas_carpeta": [["describir", "descripcion", "descripción"], ["interpretar", "interpretacion", "interpretación"], ["si", "sí"], ["si", "sí"]], "soluciones": {"incompleto": "Describir. Interpretar.", "solo": "Describo: un puente rojo sobre un río. Analizo: la diagonal del puente guía la mirada. Interpreto: une dos orillas. Valoro: me atrae por el contraste de colores.", "carpeta": ["Describir.", "Interpretar.", "Sí.", "Sí."]}}}, "act": {"1": [{"t": "classify", "p": "¿Ver, observar o apreciar?", "o": {"elementos": ["Pasar frente a un mural sin mirarlo", "Contar los colores de un mural", "Explicar por qué un mural emociona"], "categorias": ["Ver", "Observar", "Apreciar"]}, "r": {"categorias": {"Pasar frente a un mural sin mirarlo": "Ver", "Contar los colores de un mural": "Observar", "Explicar por qué un mural emociona": "Apreciar"}}, "e": "Cada nivel pide más atención."}, {"t": "multi_select", "p": "¿Qué ayuda a entrenar la mirada?", "o": ["Mirar despacio", "Preguntarse por forma y color", "Mirar sin atención", "Anotar lo que se descubre"], "r": {"correctas": ["Mirar despacio", "Preguntarse por forma y color", "Anotar lo que se descubre"]}, "e": "Mirar sin atención no entrena."}], "2": [{"t": "matching", "p": "Uní cada línea con lo que transmite.", "o": {"izquierda": ["Recta horizontal", "Recta vertical", "Diagonal", "Curva"], "derecha": ["Calma", "Firmeza", "Movimiento", "Suavidad"]}, "r": {"pares": {"Recta horizontal": "Calma", "Recta vertical": "Firmeza", "Diagonal": "Movimiento", "Curva": "Suavidad"}}, "e": "Cada línea comunica algo distinto."}, {"t": "fill_blank", "p": "La marca mínima que atrae la mirada es el ___ .", "o": [], "r": {"huecos": [["punto"]]}, "e": "Concentra la atención."}], "3": [{"t": "tap_text", "p": "Tocá la figura: «La silueta negra se destaca sobre el cielo amarillo».", "o": {"segmentos": ["La", "silueta", "negra", "se", "destaca", "sobre", "el", "cielo", "amarillo."], "modo": "palabras"}, "r": {"tocar": [1, 2]}, "e": "La silueta es la figura; el cielo, el fondo."}, {"t": "classify", "p": "¿Forma geométrica u orgánica?", "o": {"el