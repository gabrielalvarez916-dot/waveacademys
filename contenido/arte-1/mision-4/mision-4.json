{"subject_id": "825b1d79-1ef4-47ee-999d-6b5bbc1080da", "tema": 4, "practica": "Práctica general: textura y materia", "examen_titulo": "Nivel jefe: textura y materia", "niveles": {"1": {"objetivo": "Vas a reconocer y describir texturas visuales y táctiles.", "vas_a_ver": ["Qué es la textura", "Visual y táctil", "Texturas en objetos", "Textura como mensaje"], "secciones": [{"etapa": 1, "titulo": "Qué es la textura", "bloques": [{"tipo": "definicion", "titulo": "Textura", "texto": "Aspecto o sensación de la superficie de un objeto: lisa, rugosa, suave, áspera."}, {"tipo": "parrafo", "texto": "La textura se percibe con los ojos y con las manos. Un mismo objeto puede verse suave y, al tocarlo, resultar áspero."}]}, {"etapa": 1, "titulo": "Visual y táctil", "bloques": [{"tipo": "tabla", "titulo": "Dos tipos de textura", "columnas": ["Tipo", "Cómo se percibe"], "filas": [["Táctil", "Se siente al tocar: la tela, la corteza, la arena"], ["Visual", "Se ve, aunque no se toque: la que se dibuja o se pinta para imitar una superficie"]], "iguales": true}, {"tipo": "imagen", "imagen_tipo": "diagrama", "titulo": "Texturas visuales", "texto": "Seis texturas dibujadas con líneas y puntos.", "imagen_descripcion": "Seis cuadros con texturas dibujadas: rugosa, lisa, punteada, rayada, ondulada y cuadriculada, cada una hecha con líneas o puntos de distinta forma.", "imagen_fuente": "Dibujo propio (matplotlib).", "png_base64": ""}]}, {"etapa": 2, "titulo": "Texturas en objetos", "bloques": [{"tipo": "parrafo", "texto": "Los materiales tienen texturas muy distintas: la madera tiene vetas, la piedra es rugosa, el vidrio es liso y la lana es suave. Reconocerlas ayuda a representarlas."}, {"tipo": "importante", "titulo": "Tocá y mirá", "texto": "Observar de cerca un material muestra detalles que de lejos no se ven."}]}, {"etapa": 2, "titulo": "Textura como mensaje", "bloques": [{"tipo": "parrafo", "texto": "Una textura puede transmitir ideas: lo áspero sugiere dureza o cansancio, lo suave sugiere calidez y cuidado. Los artistas las eligen para reforzar lo que quieren decir."}]}], "ejemplo_completo": {"titulo": "describir", "planteo": "Tenés una hoja de papel arrugada y una de vidrio. ¿Cómo describís sus texturas?", "pasos": ["Papel arrugado: rugoso, con relieves.", "Vidrio: liso y frío.", "Cada una se puede dibujar con líneas distintas.", "Una transmite aspereza y la otra transparencia."]}, "ejemplo_incompleto": {"titulo": "completar", "planteo": "Completá.", "pasos": ["La sensación de la superficie de un objeto es la ___ .", "La textura que se ve pero no se toca es la ___ ."]}, "ejemplo_solo": {"titulo": "tu turno", "planteo": "Elegí cuatro objetos de tu casa y dibujá la textura de cada uno con líneas y puntos. Escribí si es lisa, rugosa o suave."}, "tip": {"titulo": "Mirá de cerca", "texto": "Acercate al objeto: las texturas se descubren cuando mirás con atención."}, "ojo": ["Creer que la textura solo se siente con las manos.", "Dibujar todas las texturas con el mismo tipo de línea."], "resumen": [{"titulo": "Textura", "texto": "Cómo es la superficie."}, {"titulo": "Táctil", "texto": "Se siente al tocar."}, {"titulo": "Visual", "texto": "Se ve."}, {"titulo": "Mensaje", "texto": "Sugiere ideas."}], "glosario": [{"palabra": "Textura", "significado": "Aspecto de una superficie."}, {"palabra": "Táctil", "significado": "Que se percibe al tocar."}, {"palabra": "Visual", "significado": "Que se percibe al mirar."}, {"palabra": "Relieve", "significado": "Parte que sobresale."}], "carpeta": ["¿Cómo se llama el aspecto o la sensación de la superficie de un objeto?", "¿Cómo se llama la textura que se percibe al tocar?", "¿Una textura visual se puede ver aunque no se toque? Respondé sí o no.", "¿Conviene dibujar todas las texturas con el mismo tipo de línea? Respondé sí o no."], "respuestas_carpeta": [["textura", "la textura"], ["tactil", "táctil", "textura tactil", "textura táctil"], ["si", "sí"], ["no"]], "soluciones": {"incompleto": "Textura. Táctil.", "solo": "Elegí una media, una hoja, una piedra y una taza. La media es suave y la dibujé con rulos. La piedra es rugosa y usé puntos.", "carpeta": ["Textura.", "Táctil.", "Sí.", "No."]}}, "2": {"objetivo": "Vas a crear texturas con frotage, collage y ensamblaje.", "vas_a_ver": ["Frotage", "Collage", "Ensamblaje", "Combinar técnicas"], "secciones": [{"etapa": 1, "titulo": "Frotage", "bloques": [{"tipo": "definicion", "titulo": "Frotage", "texto": "Técnica que consiste en frotar un lápiz o un crayón sobre un papel apoyado en una superficie con relieve, para copiar su textura."}, {"tipo": "parrafo", "texto": "Con el frotage se pueden copiar hojas, monedas, rejillas o troncos."}]}, {"etapa": 1, "titulo": "Collage", "bloques": [{"tipo": "definicion", "titulo": "Collage", "texto": "Obra hecha pegando sobre una superficie distintos materiales, como papeles, telas o fotos."}, {"tipo": "tabla", "titulo": "Materiales para un collage", "columnas": ["Material", "Qué aporta"], "filas": [["Papel de revista", "Colores y formas"], ["Tela", "Textura suave"], ["Cartón", "Relieve"]], "iguales": true}]}, {"etapa": 2, "titulo": "Ensamblaje", "bloques": [{"tipo": "definicion", "titulo": "Ensamblaje", "texto": "Obra en tres dimensiones armada uniendo objetos o partes de objetos."}, {"tipo": "parrafo", "texto": "El ensamblaje puede usar objetos cotidianos y reciclados para crear algo nuevo."}]}, {"etapa": 2, "titulo": "Combinar técnicas", "bloques": [{"tipo": "tabla", "titulo": "Cuándo usar cada técnica", "columnas": ["Técnica", "Resultado"], "filas": [["Frotage", "Copia una textura real"], ["Collage", "Construye una imagen con pedazos"], ["Ensamblaje", "Arma un objeto en volumen"]], "iguales": true}, {"tipo": "importante", "titulo": "Probá antes", "texto": "Probar la textura en un papel aparte evita errores en la obra."}]}], "ejemplo_completo": {"titulo": "frotage", "planteo": "Querés copiar la textura de una hoja de árbol. ¿Cómo lo hacés?", "pasos": ["Poner la hoja debajo de un papel fino.", "Inclinar un crayón y frotar suavemente.", "Mantener quieto el papel.", "Ver cómo aparecen las nervaduras."]}, "ejemplo_incompleto": {"titulo": "completar", "planteo": "Completá.", "pasos": ["La técnica de frotar un lápiz sobre un papel apoyado en un relieve es el ___ .", "La obra que se arma pegando materiales sobre una superficie es el ___ ."]}, "ejemplo_solo": {"titulo": "tu turno", "planteo": "Hacé un frotage de tres superficies distintas y armá con los resultados un collage chico. Escribí qué textura te sorprendió."}, "tip": {"titulo": "Una técnica por vez", "texto": "Probá una técnica por vez para ver qué aporta cada una."}, "ojo": ["Apretar el papel y moverlo mientras se hace el frotage.", "Usar solo pegamento en exceso."], "resumen": [{"titulo": "Frotage", "texto": "Copia texturas."}, {"titulo": "Collage", "texto": "Pega materiales."}, {"titulo": "Ensamblaje", "texto": "Obra en volumen."}, {"titulo": "Combinar", "texto": "Elegir según el resultado."}], "glosario": [{"palabra": "Frotage", "significado": "Copiar un relieve frotando."}, {"palabra": "Collage", "significado": "Obra con materiales pegados."}, {"palabra": "Ensamblaje", "significado": "Obra en tres dimensiones."}, {"palabra": "Soporte", "significado": "Superficie sobre la que se trabaja."}], "carpeta": ["¿Cómo se llama la técnica de frotar un lápiz sobre un papel apoyado en un relieve?", "¿Cómo se llama la obra que se arma pegando materiales sobre una superficie?", "¿El ensamblaje es una obra en tres dimensiones? Respondé sí o no.", "¿Conviene mover el papel mientras se hace el frotage? Respondé sí o no."], "respuestas_carpeta": [["frotage", "el frotage"], ["collage", "el collage"], ["si", "sí"], ["no"]], "soluciones": {"incompleto": "Frotage. Collage.", "solo": "Hice frotage de una moneda, una hoja y una rejilla. Después pegué los recortes y armé un paisaje. Me sorprendió la hoja.", "carpeta": ["Frotage.", "Collage.", "Sí.", "No."]}}, "3": {"objetivo": "Vas a elegir materiales y soportes según lo que querés expresar.", "vas_a_ver": ["Soporte y material", "Papel y cartón", "Tela y madera", "Materiales reciclados"], "secciones": [{"etapa": 1, "titulo": "Soporte y material", "bloques": [{"tipo": "definicion", "titulo": "Soporte", "texto": "Superficie sobre la que se trabaja una obra: papel, tela, madera, pared."}, {"tipo": "parrafo", "texto": "El material es lo que se usa para hacer la obra, como lápiz, acrílico o tinta. El soporte y el material se eligen en conjunto."}]}, {"etapa": 1, "titulo": "Papel y cartón", "bloques": [{"tipo": "tabla", "titulo": "Papeles y cartones", "columnas": ["Soporte", "Para qué sirve"], "filas": [["Papel liso", "Dibujo y lápiz"], ["Papel con grano", "Acuarela y carbonilla"], ["Cartón", "Collage y relieves"]], "iguales": true}]}, {"etapa": 2, "titulo": "Tela y madera", "bloques": [{"tipo": "parrafo", "texto": "La tela, como el lienzo, se usa para pintura al óleo y acrílico. La madera da una superficie firme y con vetas propias, que pueden formar parte de la obra."}, {"tipo": "importante", "titulo": "Preparar el soporte", "texto": "Algunos soportes necesitan una capa de base antes de pintar."}]}, {"etapa": 2, "titulo": "Materiales reciclados", "bloques": [{"tipo": "parrafo", "texto": "Cartones, tapitas, telas viejas y envases se pueden reutilizar en una obra. Reciclar también transmite un mensaje sobre el cuidado del ambiente."}, {"tipo": "tabla", "titulo": "Ideas de reciclado", "columnas": ["Material", "Posible uso"], "filas": [["Tapitas", "Mosaico"], ["Cartón", "Relieve"], ["Telas", "Collage"]], "iguales": true}]}], "ejemplo_completo": {"titulo": "elegir", "planteo": "Querés hacer una obra con mucho relieve. ¿Qué elegís?", "pasos": ["Soporte firme: un cartón grueso.", "Materiales con volumen: tapitas y telas.", "Pegamento fuerte.", "Una capa de pintura para unir los colores."]}, "ejemplo_incompleto": {"titulo": "completar", "planteo": "Completá.", "pasos": ["La superficie sobre la que se trabaja una obra es el ___ .", "Los materiales usados de nuevo son materiales ___ ."]}, "ejemplo_solo": {"titulo": "tu turno", "planteo": "Elegí un soporte y dos materiales distintos para una obra sobre tu barrio. Anotá por qué los elegiste."}, "tip": {"titulo": "Soporte y material", "texto": "Pensá primero en el soporte y después en los materiales: se eligen juntos."}, "ojo": ["Pintar con acuarela sobre un papel muy fino que se rompe.", "Tirar materiales que se podrían reutilizar."], "resumen": [{"titulo": "Soporte", "texto": "Superficie de la obra."}, {"titulo": "Material", "texto": "Con lo que se hace."}, {"titulo": "Papel y cartón", "texto": "Según la técnica."}, {"titulo": "Reciclados", "texto": "Dan una segunda vida."}], "glosario": [{"palabra": "Soporte", "significado": "Superficie de trabajo."}, {"palabra": "Lienzo", "significado": "Tela para pintar."}, {"palabra": "Veta", "significado": "Dibujo natural de la madera."}, {"palabra": "Reciclar", "significado": "Usar de nuevo."}], "carpeta": ["¿Cómo se llama la superficie sobre la que se trabaja una obra?", "¿Cómo se llama a los materiales usados de nuevo para hacer una obra?", "¿La madera tiene vetas propias? Respondé sí o no.", "¿Conviene tirar los materiales que se podrían reutilizar? Respondé sí o no."], "respuestas_carpeta": [["soporte", "el soporte"], ["reciclados", "materiales reciclados", "reciclables"], ["si", "sí"], ["no"]], "soluciones": {"incompleto": "Soporte. Reciclados.", "solo": "Elegí un cartón grueso como soporte, tapitas y telas como materiales. Quise mostrar mi barrio con colores y relieves.", "carpeta": ["Soporte.", "Reciclados.", "Sí.", "No."]}}, "4": {"objetivo": "Vas a combinar técnicas para armar una obra de técnica mixta.", "vas_a_ver": ["Qué es la técnica mixta", "Capas y orden", "Armonía de texturas", "Obra final"], "secciones": [{"etapa": 1, "titulo": "Qué es la técnica mixta", "bloques": [{"tipo": "definicion", "titulo": "Técnica mixta", "texto": "Obra que combina dos o más técnicas o materiales, como dibujo, pintura y collage."}, {"tipo": "parrafo", "texto": "La técnica mixta permite sumar la textura, el color y el volumen en una misma obra."}]}, {"etapa": 1, "titulo": "Capas y orden", "bloques": [{"tipo": "tabla", "titulo": "Orden de trabajo", "columnas": ["Paso", "Qué se hace"], "filas": [["1. Fondo", "Pintar o pegar la base"], ["2. Texturas", "Sumar frotage y collage"], ["3. Dibujo", "Marcar formas con lápiz o tinta"], ["4. Detalles", "Agregar brillos y toques finales"]], "iguales": true}]}, {"etapa": 2, "titulo": "Armonía de texturas", "bloques": [{"tipo": "parrafo", "texto": "Si hay demasiadas texturas distintas, la obra se ve cargada. Conviene que una domine y las otras acompañen, igual que con los colores."}, {"tipo": "importante", "titulo": "Descanso visual", "texto": "Dejar una zona lisa ayuda a que se destaquen las texturas."}]}, {"etapa": 2, "titulo": "Obra final", "bloques": [{"tipo": "tabla", "titulo": "Qué revisar al terminar", "columnas": ["Pregunta", "Qué mirar"], "filas": [["¿Se entiende la idea?", "Tema y mensaje"], ["¿Hay equilibrio?", "Texturas y colores"], ["¿Se secó todo?", "Evitar que se despegue"]], "iguales": true}]}], "ejemplo_completo": {"titulo": "técnica mixta", "planteo": "Vas a armar una obra sobre el mar con técnica mixta. ¿Cómo la planeás?", "pasos": ["Fondo: pintura azul con esponja.", "Texturas: arena pegada y frotage de redes.", "Dibujo: peces con lápiz negro.", "Detalles: brillos blancos de pintura."]}, "ejemplo_incompleto": {"titulo": "completar", "planteo": "Completá.", "pasos": ["La obra que combina dos o más técnicas o materiales es de técnica ___ .", "Conviene que una textura ___ y las otras acompañen."]}, "ejemplo_solo": {"titulo": "tu turno", "planteo": "Armá una obra chica de técnica mixta con al menos tres materiales o técnicas. Anotá el orden que seguiste."}, "tip": {"titulo": "Menos es más", "texto": "Una zona lisa le da descanso a la mirada y hace que se luzcan las texturas."}, "ojo": ["Pegar todos los materiales a la vez, sin orden.", "Usar