{"subject_id": "825b1d79-1ef4-47ee-999d-6b5bbc1080da", "tema": 5, "practica": "Práctica general: componer el espacio", "examen_titulo": "Nivel jefe: componer el espacio", "niveles": {"1": {"objetivo": "Vas a organizar los elementos de una imagen con equilibrio, ritmo y puntos de interés.", "vas_a_ver": ["Qué es componer", "Equilibrio", "Ritmo", "Puntos de interés"], "secciones": [{"etapa": 1, "titulo": "Qué es componer", "bloques": [{"tipo": "definicion", "titulo": "Composición", "texto": "Forma en que se organizan los elementos dentro del espacio de una obra."}, {"tipo": "parrafo", "texto": "Una buena composición guía la mirada y ayuda a que se entienda lo que se quiere mostrar."}]}, {"etapa": 1, "titulo": "Equilibrio", "bloques": [{"tipo": "tabla", "titulo": "Tipos de equilibrio", "columnas": ["Tipo", "Cómo es"], "filas": [["Simétrico", "Los elementos se repiten parejos a ambos lados de un eje"], ["Asimétrico", "Los elementos son distintos, pero se compensan por peso y color"]], "iguales": true}, {"tipo": "imagen", "imagen_tipo": "diagrama", "titulo": "Tres formas de componer", "texto": "Simétrica, asimétrica y regla de tercios.", "imagen_descripcion": "Tres cuadros: en el primero dos círculos iguales a ambos lados de un eje; en el segundo un círculo grande y uno pequeño de otro color que se compensan; en el tercero una cuadrícula de tercios con un círculo en una intersección y un rectángulo abajo a la izquierda.", "imagen_fuente": "Dibujo propio (matplotlib).", "png_base64": ""}]}, {"etapa": 2, "titulo": "Ritmo", "bloques": [{"tipo": "definicion", "titulo": "Ritmo", "texto": "Repetición de elementos que crea movimiento en la obra."}, {"tipo": "parrafo", "texto": "El ritmo puede ser regular, si el elemento se repite igual, o variado, si cambia de tamaño, color o distancia."}]}, {"etapa": 2, "titulo": "Puntos de interés", "bloques": [{"tipo": "parrafo", "texto": "El punto de interés es la zona que más atrae la mirada. Se destaca con contraste, tamaño, color o ubicándolo en las intersecciones de la regla de tercios."}, {"tipo": "importante", "titulo": "Un solo protagonista", "texto": "Conviene que haya un punto de interés principal."}]}], "ejemplo_completo": {"titulo": "componer", "planteo": "Vas a componer una imagen con una casa y un árbol. ¿Cómo lo hacés?", "pasos": ["Dividir la hoja en tercios con líneas suaves.", "Poner la casa en una intersección.", "Colocar el árbol del otro lado para compensar.", "Repetir ventanas para crear ritmo."]}, "ejemplo_incompleto": {"titulo": "completar", "planteo": "Completá.", "pasos": ["La forma de organizar los elementos en el espacio de una obra es la ___ .", "La repetición de elementos que crea movimiento es el ___ ."]}, "ejemplo_solo": {"titulo": "tu turno", "planteo": "Hacé tres composiciones chicas con las mismas formas: una simétrica, una asimétrica y una con regla de tercios. Anotá cuál te gustó más."}, "tip": {"titulo": "Mirá el conjunto", "texto": "Antes de dibujar un detalle, mirá cómo queda el conjunto en la hoja."}, "ojo": ["Poner todos los elementos en el centro.", "Querer destacar todo al mismo tiempo."], "resumen": [{"titulo": "Composición", "texto": "Organiza el espacio."}, {"titulo": "Equilibrio", "texto": "Simétrico o asimétrico."}, {"titulo": "Ritmo", "texto": "Repetición."}, {"titulo": "Interés", "texto": "Punto que atrae."}], "glosario": [{"palabra": "Composición", "significado": "Organización de los elementos."}, {"palabra": "Simetría", "significado": "Partes iguales a ambos lados."}, {"palabra": "Ritmo", "significado": "Repetición que da movimiento."}, {"palabra": "Contraste", "significado": "Diferencia que destaca."}], "carpeta": ["¿Cómo se llama la forma de organizar los elementos en el espacio de una obra?", "¿Cómo se llama la repetición de elementos que crea movimiento?", "¿Conviene que haya un punto de interés principal? Respondé sí o no.", "¿Conviene poner todos los elementos en el centro? Respondé sí o no."], "respuestas_carpeta": [["composicion", "composición", "la composicion", "la composición"], ["ritmo", "el ritmo"], ["si", "sí"], ["no"]], "soluciones": {"incompleto": "Composición. Ritmo.", "solo": "Hice tres cuadros con una casa y un árbol: simétrico con ambos al centro, asimétrico con la casa grande y el árbol chico, y uno con la casa en un tercio. Me gustó el de tercios.", "carpeta": ["Composición.", "Ritmo.", "Sí.", "No."]}}, "2": {"objetivo": "Vas a elegir planos, encuadres y puntos de vista para mostrar una escena.", "vas_a_ver": ["Los planos", "Encuadre", "Punto de vista", "Elegir con intención"], "secciones": [{"etapa": 1, "titulo": "Los planos", "bloques": [{"tipo": "imagen", "imagen_tipo": "diagrama", "titulo": "Planos de una imagen", "texto": "Plano general, plano medio y primer plano.", "imagen_descripcion": "Tres cuadros con la misma figura: en el plano general se ve pequeña y rodeada de espacio; en el plano medio se ve de la cintura para arriba; en el primer plano ocupa casi todo el cuadro.", "imagen_fuente": "Dibujo propio (matplotlib).", "png_base64": ""}, {"tipo": "tabla", "titulo": "Los planos más usados", "columnas": ["Plano", "Qué muestra"], "filas": [["General", "Todo el lugar y la figura chica"], ["Medio", "La figura de la cintura para arriba"], ["Primer plano", "El detalle, como el rostro"]], "iguales": true}]}, {"etapa": 1, "titulo": "Encuadre", "bloques": [{"tipo": "definicion", "titulo": "Encuadre", "texto": "Recorte de la escena que decidimos mostrar."}, {"tipo": "parrafo", "texto": "Lo que queda fuera del encuadre no se ve. Encuadrar es elegir qué entra y qué se deja afuera."}]}, {"etapa": 2, "titulo": "Punto de vista", "bloques": [{"tipo": "tabla", "titulo": "Desde dónde se mira", "columnas": ["Punto de vista", "Efecto"], "filas": [["A la altura de los ojos", "Natural, cercano"], ["Picado, desde arriba", "El objeto parece chico o débil"], ["Contrapicado, desde abajo", "El objeto parece grande e imponente"]], "iguales": true}]}, {"etapa": 2, "titulo": "Elegir con intención", "bloques": [{"tipo": "parrafo", "texto": "Un mismo objeto cambia de significado según el plano y el punto de vista. Por eso conviene preguntarse qué se quiere transmitir antes de elegir."}, {"tipo": "importante", "titulo": "Probar varios", "texto": "Hacer bocetos del mismo tema desde varios puntos de vista ayuda a decidir."}]}], "ejemplo_completo": {"titulo": "encuadrar", "planteo": "Querés mostrar un árbol enorme. ¿Qué plano y punto de vista elegís?", "pasos": ["Punto de vista contrapicado, desde abajo.", "Plano general para que se vea completo.", "Dejar poco cielo para sentir su altura.", "Probar un boceto desde arriba para comparar."]}, "ejemplo_incompleto": {"titulo": "completar", "planteo": "Completá.", "pasos": ["El recorte de la escena que decidimos mostrar es el ___ .", "Mirar desde abajo hacia arriba es un punto de vista ___ ."]}, "ejemplo_solo": {"titulo": "tu turno", "planteo": "Elegí un objeto y hacé tres bocetos: plano general, primer plano y desde un punto de vista picado. Escribí qué cambia."}, "tip": {"titulo": "Decidí qué entra", "texto": "Antes de dibujar, decidí qué entra en el cuadro y qué se queda afuera."}, "ojo": ["Mostrar siempre todo con el mismo plano.", "Creer que el punto de vista no cambia el mensaje."], "resumen": [{"titulo": "Planos", "texto": "General, medio y primer plano."}, {"titulo": "Encuadre", "texto": "Qué se muestra."}, {"titulo": "Picado", "texto": "Desde arriba."}, {"titulo": "Contrapicado", "texto": "Desde abajo."}], "glosario": [{"palabra": "Plano", "significado": "Distancia a la que se ve el objeto."}, {"palabra": "Encuadre", "significado": "Recorte de la escena."}, {"palabra": "Picado", "significado": "Visto desde arriba."}, {"palabra": "Contrapicado", "significado": "Visto desde abajo."}], "carpeta": ["¿Cómo se llama el recorte de la escena que decidimos mostrar?", "¿Cómo se llama el punto de vista desde abajo hacia arriba?", "¿El primer plano muestra un detalle de cerca? Respondé sí o no.", "¿Un mismo objeto puede cambiar de significado según el punto de vista? Respondé sí o no."], "respuestas_carpeta": [["encuadre", "el encuadre"], ["contrapicado", "el contrapicado", "contrapicada"], ["si", "sí"], ["si", "sí"]], "soluciones": {"incompleto": "Encuadre. Contrapicado.", "solo": "Elegí una lámpara. En plano general se ve chica, en primer plano se ve el detalle de la pantalla y desde arriba parece aplastada.", "carpeta": ["Encuadre.", "Contrapicado.", "Sí.", "Sí."]}}, "3": {"objetivo": "Vas a reconocer y representar espacios interiores, exteriores, públicos y privados.", "vas_a_ver": ["Interior y exterior", "Público y privado", "Representar el lugar", "Atmósfera"], "secciones": [{"etapa": 1, "titulo": "Interior y exterior", "bloques": [{"tipo": "tabla", "titulo": "Dos tipos de espacio", "columnas": ["Espacio", "Ejemplos"], "filas": [["Interior", "Una habitación, un aula, un museo"], ["Exterior", "Una plaza, una calle, un patio"]], "iguales": true}]}, {"etapa": 1, "titulo": "Público y privado", "bloques": [{"tipo": "definicion", "titulo": "Espacio público", "texto": "Lugar abierto a todas las personas, como una plaza o una biblioteca."}, {"tipo": "definicion", "titulo": "Espacio privado", "texto": "Lugar de uso reservado, como una casa o un jardín propio."}]}, {"etapa": 2, "titulo": "Representar el lugar", "bloques": [{"tipo": "parrafo", "texto": "Para representar un espacio se eligen sus elementos más importantes y su escala: un interior suele mostrar paredes y muebles, y un exterior, cielo, suelo y construcciones."}, {"tipo": "importante", "titulo": "Mirar el espacio", "texto": "Observar un lugar real antes de dibujarlo ayuda a captar su carácter."}]}, {"etapa": 2, "titulo": "Atmósfera", "bloques": [{"tipo": "parrafo", "texto": "Los colores, la luz y los objetos crean la atmósfera de un espacio. Una luz cálida y pocos objetos pueden dar sensación de calma, mientras que muchos objetos y colores fuertes dan sensación de movimiento."}]}], "ejemplo_completo": {"titulo": "espacio", "planteo": "Querés dibujar tu cuarto como un espacio íntimo. ¿Qué decidís?", "pasos": ["Es un espacio interior y privado.", "Mostrar los muebles más importantes.", "Usar luz cálida y colores suaves.", "Agregar objetos personales que cuenten quién lo usa."]}, "ejemplo_incompleto": {"titulo": "completar", "planteo": "Completá.", "pasos": ["Un lugar abierto a todas las personas es un espacio ___ .", "Los colores y la luz crean la ___ de un espacio."]}, "ejemplo_solo": {"titulo": "tu turno", "planteo": "Dibujá dos espacios de tu barrio, uno interior y uno exterior, y escribí si son públicos o privados."}, "tip": {"titulo": "Un espacio con carácter", "texto": "Pensá qué sensación querés que tenga el espacio antes de elegir los colores."}, "ojo": ["Creer que un espacio exterior siempre es público.", "Dibujar todos los objetos sin elegir los importantes."], "resumen": [{"titulo": "Interior", "texto": "Dentro de un lugar cubierto."}, {"titulo": "Exterior", "texto": "Al aire libre."}, {"titulo": "Público", "texto": "Abierto a todos."}, {"titulo": "Privado", "texto": "De uso reservado."}], "glosario": [{"palabra": "Interior", "significado": "Espacio cubierto."}, {"palabra": "Exterior", "significado": "Espacio al aire libre."}, {"palabra": "Público", "significado": "De todas las personas."}, {"palabra": "Atmósfera", "significado": "Sensación de un lugar."}], "carpeta": ["¿Cómo se llama el espacio abierto a todas las personas?", "¿Cómo se llama la sensación que crean los colores y la luz en un espacio?", "¿Una plaza es un espacio exterior? Respondé sí o no.", "¿Un patio propio siempre es un espacio público? Respondé sí o no."], "respuestas_carpeta": [["publico", "público", "espacio publico", "espacio público"], ["atmosfera", "atmósfera", "la atmosfera", "la atmósfera"], ["si", "sí"], ["no"]], "soluciones": {"incompleto": "Público. Atmósfera.", "solo": "Dibujé mi aula, un espacio interior y público, y la plaza, exterior y pública. En el aula puse pupitres y en la plaza, árboles y bancos.", "carpeta": ["Público.", "Atmósfera.", "Sí.", "No."]}}, "4": {"objetivo": "Vas a pasar de la representación plana al volumen y a representar el espacio en tres dimensiones.", "vas_a_ver": ["Dos y tres dimensiones", "Planta y vista", "Maqueta", "Probar y ajustar"], "secciones": [{"etapa": 1, "titulo": "Dos y tres dimensiones", "bloques": [{"tipo": "definicion", "titulo": "Bidimensional", "texto": "Obra o figura que tiene alto y ancho, como un dibujo sobre una hoja."}, {"tipo": "definicion", "titulo": "Tridimensional", "texto": "Obra o figura que tiene alto, ancho y profundidad, como una escultura."}]}, {"etapa": 1, "titulo": "Planta y vista", "bloques": [{"tipo": "tabla", "titulo": "Representar un espacio", "columnas": ["Representación", "Qué muestra"], "filas": [["Planta", "El espacio visto desde arriba"], ["Vista frontal", "El espacio visto de frente"], ["Maqueta", "El espacio en volumen y a escala"]], "iguales": true}]}, {"etapa": 2, "titulo": "Maqueta", "bloques": [{"tipo": "parrafo", "texto": "Una maqueta es un modelo en tres dimensiones de un espacio. Se arma con cartón, papel, plastilina u objetos pequeños, manteniendo las proporciones."}, {"tipo": "importante", "titulo": "Escala", "texto": "Todas las partes deben usar la misma escala para que la maqueta se vea creíble."}]}, {"etapa": 2, "titulo": "Probar y ajustar", "bloques": [{"tipo": "parrafo", "texto": "Al pasar del plano a la maqueta se descubren problemas que en el dibujo no se veían. Conviene probar, mirar desde varios lados y ajustar."}]}], "ejemplo_completo": {"titulo": "maqueta", "planteo": "Vas a hacer la maqueta de tu aula. ¿Cómo lo hacés?", "pasos": ["Dibujar la planta del aula.", "Cortar cartones con la medida de cada pared.", "Armar los muebles con cajitas pequeñas.", "Mirar desde varios lados y ajustar."]}, "ejemplo_incompleto": {"titulo": "completar", "planteo": "Completá.", "pasos": ["Una obra con alto y ancho es ___ .", "Un modelo en tres dimensiones de un espacio es una ___ ."]}, "ejemplo_solo": {