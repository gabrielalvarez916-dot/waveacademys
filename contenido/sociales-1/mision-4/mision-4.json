{"subject_id": "a5f9b6fc-7f3b-4743-977d-da7f4f3a37bb", "tema": 4, "practica": "Práctica general: los ambientes del planeta", "examen_titulo": "Nivel jefe: los ambientes del planeta", "niveles": {"1": {"objetivo": "Vas a reconocer las cuatro esferas de la Tierra y cómo se conectan.", "vas_a_ver": ["Las cuatro esferas", "El agua del planeta", "El ciclo del agua", "Qué es un ambiente"], "secciones": [{"etapa": 1, "titulo": "Las esferas", "bloques": [{"tipo": "tabla", "titulo": "Las cuatro esferas", "columnas": ["Esfera", "Qué incluye", "Ejemplo"], "filas": [["Litósfera", "Rocas, suelo, relieve", "La cordillera de los Andes"], ["Hidrósfera", "Toda el agua, líquida o congelada", "El glaciar Perito Moreno"], ["Atmósfera", "La capa de gases que rodea la Tierra", "Las nubes y el viento"], ["Biósfera", "Todos los seres vivos", "El yaguareté, los pastos, las personas"]], "iguales": true}]}, {"etapa": 1, "titulo": "Agua y ciclo", "bloques": [{"tipo": "parrafo", "texto": "El <b>97 %</b> del agua del planeta es salada. De la dulce, la mayor parte está congelada: la que usamos fácilmente, en ríos, lagos y napas, es una parte mínima."}, {"tipo": "tabla", "titulo": "El ciclo del agua", "columnas": ["Paso", "Qué pasa", "Esferas"], "filas": [["Evaporación", "El sol calienta el agua y sube como vapor", "Hidrósfera → atmósfera"], ["Condensación", "El vapor se enfría y forma nubes", "Atmósfera"], ["Precipitación", "Cae lluvia o nieve", "Atmósfera → litósfera y biósfera"], ["Escurrimiento", "El agua corre por ríos y napas hasta el mar", "Litósfera → hidrósfera"]], "iguales": true}]}, {"etapa": 2, "titulo": "Ambiente", "bloques": [{"tipo": "definicion", "titulo": "Ambiente", "texto": "La naturaleza más lo que las sociedades hicieron con ella; es natural y social a la vez."}, {"tipo": "parrafo", "texto": "Una represa, un campo de soja o una ciudad son parte del ambiente: transforman la litósfera, la hidrósfera y la biósfera."}]}], "ejemplo_completo": {"titulo": "conectar", "planteo": "Un incendio forestal, ¿qué esferas afecta?", "pasos": ["Biósfera: se queman plantas y mueren animales.", "Atmósfera: el humo cambia el aire.", "Litósfera: el suelo queda sin protección y se erosiona.", "Una esfera afecta a las otras: están conectadas."]}, "ejemplo_incompleto": {"titulo": "completar", "planteo": "Completá.", "pasos": ["La capa de gases que rodea la Tierra es la ___ .", "El agua pasa al aire por ___ ."]}, "ejemplo_solo": {"titulo": "tu turno", "planteo": "Elegí un lugar cerca de tu casa y nombrá un elemento de cada esfera que haya ahí."}, "tip": {"titulo": "Pensá en conexiones", "texto": "Casi todo lo que pasa en una esfera repercute en otra: preguntate siempre a cuál más afecta."}, "ojo": ["Dejar a las personas fuera de la biósfera.", "Olvidar que el hielo es parte de la hidrósfera."], "resumen": [{"titulo": "Litósfera", "texto": "Rocas y suelo."}, {"titulo": "Hidrósfera", "texto": "Toda el agua."}, {"titulo": "Atmósfera", "texto": "El aire."}, {"titulo": "Biósfera", "texto": "Los seres vivos."}], "glosario": [{"palabra": "Litósfera", "significado": "Capa sólida de la Tierra."}, {"palabra": "Atmósfera", "significado": "Capa de gases que rodea al planeta."}, {"palabra": "Ambiente", "significado": "Naturaleza transformada por la sociedad."}], "carpeta": ["¿A qué esfera pertenece un glaciar?", "¿Qué porcentaje del agua del planeta es salada? Respondé solo el número.", "¿Las personas forman parte de la biósfera? Respondé sí o no.", "¿Cómo se llama el paso del ciclo del agua en el que se forman nubes?"], "respuestas_carpeta": [["hidrosfera", "hidrósfera", "la hidrosfera", "la hidrósfera"], ["97", "97%"], ["si", "sí"], ["condensacion", "condensación", "la condensación", "la condensacion"]], "soluciones": {"incompleto": "Atmósfera. Evaporación.", "solo": "Respuesta personal: un elemento de cada esfera.", "carpeta": ["Hidrósfera.", "97.", "Sí.", "Condensación."]}}, "2": {"objetivo": "Vas a diferenciar tiempo y clima, explicar los factores del clima y reconocer los grandes biomas.", "vas_a_ver": ["Tiempo y clima", "Factores del clima", "Los biomas", "Ejemplos del mundo"], "secciones": [{"etapa": 1, "titulo": "Tiempo y clima", "bloques": [{"tipo": "tabla", "titulo": "No son lo mismo", "columnas": ["", "Tiempo", "Clima"], "filas": [["Qué es", "Estado de la atmósfera en un momento", "Promedio de muchos años (unos 30)"], ["Ejemplo", "Hoy llueve en Rosario", "Rosario tiene clima templado húmedo"]], "iguales": true}]}, {"etapa": 1, "titulo": "Factores del clima", "bloques": [{"tipo": "tabla", "titulo": "Factores", "columnas": ["Factor", "Efecto"], "filas": [["Latitud", "Cerca del Ecuador, más calor; cerca de los polos, más frío"], ["Altura", "Cada 1000 m que se sube, la temperatura baja unos 6 °C"], ["Cercanía al mar", "El mar modera: menos diferencia entre calor y frío"], ["Vientos y corrientes", "Traen o quitan humedad"]], "iguales": true}]}, {"etapa": 2, "titulo": "Biomas", "bloques": [{"tipo": "tabla", "titulo": "Grandes biomas", "columnas": ["Bioma", "Clima", "Ejemplo"], "filas": [["Selva", "Cálido y muy lluvioso", "Amazonia"], ["Sabana", "Cálido con estación seca", "Centro de África"], ["Desierto", "Muy seco", "Sahara"], ["Pradera", "Templado", "Pampa"], ["Taiga", "Frío, bosques de pinos", "Siberia"], ["Tundra", "Helado, sin árboles", "Norte de Canadá"]], "iguales": true}]}], "ejemplo_completo": {"titulo": "explicar", "planteo": "¿Por qué en Ushuaia hace más frío que en Manaos, Brasil?", "pasos": ["Ushuaia está en una latitud alta, cerca del polo sur.", "Manaos está casi sobre el Ecuador.", "Los rayos del sol llegan más directos cerca del Ecuador: más calor.", "El factor principal es la latitud."]}, "ejemplo_incompleto": {"titulo": "completar", "planteo": "Completá.", "pasos": ["El promedio del estado de la atmósfera durante muchos años es el ___ .", "El bioma helado y sin árboles es la ___ ."]}, "ejemplo_solo": {"titulo": "tu turno", "planteo": "Describí el clima de tu ciudad: ¿cálido, templado o frío? ¿Llueve mucho o poco? ¿Qué factor lo explica más?"}, "tip": {"titulo": "Hoy o siempre", "texto": "Si habla de hoy, es tiempo. Si habla de cómo es siempre, es clima."}, "ojo": ["Confundir tiempo con clima.", "Pensar que el norte siempre es más frío: en el hemisferio sur es al revés."], "resumen": [{"titulo": "Tiempo", "texto": "La atmósfera ahora."}, {"titulo": "Clima", "texto": "Promedio de años."}, {"titulo": "Factores", "texto": "Latitud, altura, mar, vientos."}, {"titulo": "Bioma", "texto": "Vegetación según el clima."}], "glosario": [{"palabra": "Clima", "significado": "Promedio del estado de la atmósfera en muchos años."}, {"palabra": "Bioma", "significado": "Gran zona con vegetación y fauna adaptadas a un clima."}, {"palabra": "Latitud", "significado": "Distancia al Ecuador."}], "carpeta": ["\"Mañana va a llover\", ¿habla del tiempo o del clima?", "¿Qué factor explica la nieve en la cumbre del Aconcagua?", "¿Qué bioma tiene calor y lluvias todo el año?", "¿En qué bioma está la Pampa?"], "respuestas_carpeta": [["tiempo", "del tiempo", "el tiempo"], ["altura", "la altura", "altitud", "la altitud"], ["selva", "la selva"], ["pradera", "la pradera"]], "soluciones": {"incompleto": "Clima. Tundra.", "solo": "Respuesta personal con un factor.", "carpeta": ["Del tiempo.", "La altura.", "La selva.", "Pradera."]}}, "3": {"objetivo": "Vas a reconocer grandes ambientes de América Latina y su importancia para el mundo.", "vas_a_ver": ["Amazonia", "Andes y Atacama", "Pampa", "Ambiente y sociedad"], "secciones": [{"etapa": 1, "titulo": "Tres ambientes", "bloques": [{"tipo": "tabla", "titulo": "Ambientes", "columnas": ["Ambiente", "Dónde", "Rasgo"], "filas": [["Amazonia", "Nueve países; casi dos tercios en Brasil", "La selva tropical más grande del planeta"], ["Andes", "Desde Venezuela hasta Tierra del Fuego", "La cordillera más larga del mundo"], ["Atacama", "Norte de Chile", "El desierto no polar más seco"], ["Pampa", "Argentina y Uruguay", "Llanura de pastizales con suelos muy fértiles"]], "iguales": true}]}, {"etapa": 1, "titulo": "Para el mundo", "bloques": [{"tipo": "tabla", "titulo": "Qué se hace y por qué importa", "columnas": ["Ambiente", "Actividades", "Importancia mundial"], "filas": [["Amazonia", "Madera, ganado, soja", "Biodiversidad; genera lluvias para la región"], ["Andes", "Minería de cobre y litio", "El litio se usa en baterías"], ["Pampa", "Granos y carne", "Alimentos para muchos países"]], "iguales": true}]}, {"etapa": 2, "titulo": "Un ambiente transformado", "bloques": [{"tipo": "parrafo", "texto": "Antes, la Pampa era un mar de pastizales con venados y ñandúes. Hoy está casi toda ocupada por cultivos y ganado. Es un ejemplo de <b>ambiente</b>: naturaleza transformada por la sociedad. En la Amazonia, la tala para ganado y soja preocupa al mundo porque reduce la selva."}]}], "ejemplo_completo": {"titulo": "analizar", "planteo": "¿Por qué la tala de la Amazonia importa también en Argentina?", "pasos": ["La selva devuelve mucha humedad al aire.", "Los vientos llevan esa humedad hacia el sur.", "Parte de las lluvias del norte y centro de Argentina dependen de ella.", "Lo que pasa en un ambiente afecta a otros lejanos."]}, "ejemplo_incompleto": {"titulo": "completar", "planteo": "Completá.", "pasos": ["La selva tropical más grande del planeta es la ___ .", "El mineral de los Andes que se usa en baterías es el ___ ."]}, "ejemplo_solo": {"titulo": "tu turno", "planteo": "Elegí uno de los tres ambientes y explicá en dos oraciones cómo lo transformó la sociedad."}, "tip": {"titulo": "Naturaleza + sociedad", "texto": "Al describir un ambiente, contá cómo es la naturaleza y qué hicieron las personas con ella."}, "ojo": ["Creer que la Amazonia es solo de Brasil.", "Pensar que un ambiente es solo naturaleza."], "resumen": [{"titulo": "Amazonia", "texto": "Selva más grande."}, {"titulo": "Andes", "texto": "Cordillera y minería."}, {"titulo": "Atacama", "texto": "Desierto más seco."}, {"titulo": "Pampa", "texto": "Pastizales hechos campos."}], "glosario": [{"palabra": "Selva tropical", "significado": "Bosque denso de clima cálido y lluvioso."}, {"palabra": "Litio", "significado": "Mineral usado en baterías."}, {"palabra": "Biodiversidad", "significado": "Variedad de seres vivos de un lugar."}], "carpeta": ["¿En qué país está la mayor parte de la Amazonia?", "¿Cuál es el desierto no polar más seco del planeta?", "¿Para qué se usa el litio?", "¿En qué dos países está la Pampa?"], "respuestas_carpeta": [["brasil"], ["atacama", "el desierto de atacama", "desierto de atacama"], ["baterias", "baterías", "para baterias", "para baterías"], ["argentina y uruguay", "uruguay y argentina"]], "soluciones": {"incompleto": "Amazonia. Litio.", "solo": "Respuesta personal.", "carpeta": ["Brasil.", "Atacama.", "Para baterías.", "Argentina y Uruguay."]}}, "4": {"objetivo": "Vas a leer un climograma, calcular la amplitud térmica e interpretar un mapa temático.", "vas_a_ver": ["Qué es un climograma", "La línea y las barras", "La amplitud térmica", "Mapas temáticos"], "secciones": [{"etapa": 1, "titulo": "El climograma", "bloques": [{"tipo": "imagen", "imagen_tipo": "diagrama", "titulo": "Climograma", "texto": "Barras: lluvia de cada mes. Línea: temperatura media.", "imagen_descripcion": "Gráfico con barras azules de lluvia y una línea roja de temperatura para los doce meses.", "imagen_fuente": "Dibujo propio (matplotlib).", "png_base64": ""}, {"tipo": "parrafo", "texto": "Las <b>barras</b> muestran la lluvia de cada mes, en milímetros. La <b>línea</b> muestra la temperatura media, en grados."}]}, {"etapa": 1, "titulo": "Leerlo paso a paso", "bloques": [{"tipo": "tabla", "titulo": "Cómo leerlo", "columnas": ["Paso", "Qué hacer"], "filas": [["1", "Mirá el lugar y su hemisferio"], ["2", "Leé la línea: ¿cuándo hace más calor y más frío?"], ["3", "Leé las barras: ¿cuándo llueve más?"], ["4", "Calculá la amplitud térmica"], ["5", "Concluí: cálido o frío, lluvioso o seco"]], "iguales": true}, {"tipo": "ejemplo", "titulo": "Amplitud térmica", "texto": "Buenos Aires: máxima 24 °C, mínima 10 °C.", "items": ["Amplitud = máxima − mínima.", "24 − 10 = 14 °C.", "Es baja porque está cerca del mar."]}]}, {"etapa": 2, "titulo": "Mapas temáticos", "bloques": [{"tipo": "parrafo", "texto": "Un <b>mapa temático</b> muestra un solo tema: lluvias, población, selvas, cultivos. Sirve para descubrir patrones; por ejemplo, las selvas tropicales aparecen siempre cerca del Ecuador."}]}], "ejemplo_completo": {"titulo": "interpretar", "planteo": "Un climograma tiene barras muy bajas todo el año y temperaturas altas. ¿Qué clima es?", "pasos": ["Barras bajas: llueve muy poco.", "Línea alta: hace calor.", "Es un clima cálido y seco: desértico."]}, "ejemplo_incompleto": {"titulo": "completar", "planteo": "Completá.", "pasos": ["En un climograma, la lluvia se muestra con ___ .", "La diferencia entre la temperatura más alta y la más baja es la ___ térmica."]}, "ejemplo_solo": {"titulo": "tu turno", "planteo": "Con el climograma del PDF, decí en qué mes llueve más y en cuál hace más frío en Buenos Aires."}, "tip": {"titulo": "Barras = agua, línea = calor", "texto": "No mezcles: las barras son lluvia y la línea es temperatura."}, "ojo": ["Leer las barras como temperatura.", "Olvidar el hemisferio: en el norte, el verano cae en otros meses."], "resumen": [{"titulo": "Climograma", "texto": "Clima de un lugar."}, {"titulo": "Línea", "texto": "Temperatura."}, {"titulo": "Barras", "texto": "Lluvia en mm."}, {"titulo": "Amplitud", "texto": "Máxima − mínima."}], "glosario": [{"palabra": "Climograma", "significado": "Gráfico de temperaturas y lluvias de un lugar a lo largo del año."}, {"palabra": "Amplitud térmica", "significado": "Diferencia entre la temperatura más alta y la más baja."}, {"palabra": "Mapa temático", "significado": "Mapa que muestra un solo tema."}], "carpeta": ["Máxima 30 °C, mínima 12 °C. ¿Cuál es la amplitud térmica? Respondé solo el número.", "En un climograma, ¿qué muestran las barras?", "En un climograma, ¿qué muestra la línea?", "Un mapa de lluvias del mundo, ¿es físico, político o temático?"], "respuestas_carpeta": [["18", "18 °c", "18°"], ["lluvia", "lluvias", "la lluvia", "las lluvias", "precipitaciones", "precipitacion", "precipitación"], ["temperatura", "la temperatura", "temperaturas"], ["tematico", "temático"]], "soluciones": {"incompleto": "Barras. Amplitud.", "solo": "Más lluvia: mes 3. Más frío: mes 7.", "carpeta": ["18.", "La lluvia.", "La temperatura.", "Temático."]}}}, "act": {"1": [{"t": "classify", "p": "¿A qué esfera pertenece?", "o": {"elementos": ["Una montaña", "Un glaciar", "El viento", "Un yaguareté"], "categorias": ["Litósfera", "Hidrósfera", "Atmósfera", "Biósfera"]}, "r": {"categorias": {"Una montaña": "Litósfera", "Un glaciar": "Hidrósfera", "El viento": "Atmósfera", "Un yaguareté": "Biósfera"}}, "e": "Cada elemento, a su esfera."}, {"t": "multiple_choice", "p": "¿Por qué una represa es parte del ambiente?", "o": ["Porque el ambiente incluye lo que la sociedad hizo con la naturaleza", "Porque es un elemento natural", "Porque está en la atmósfera", "Porque no lo es"], "r": {"correcta": "Porque el ambiente incluye lo que la sociedad hizo con la naturaleza"}, "e": "Natural y social a la vez."}], "2": [{"t": "matching", "p": "Uní cada bioma con su clima.", "o": {"izquierda": ["Selva", "Desierto", "Tundra"], "derecha": ["Cálido y muy lluvioso", "Muy seco", "Helado, sin árboles"]}, "r": {"pares": {"Selva": "Cálido y muy lluvioso", "Desierto": "Muy seco", "Tundra": "Helado, sin árboles"}}, "e": "Cada clima, su vegetación."}, {"t": "multiple_choice", "p": "Subís 2000 metros por una montaña. ¿Cuánto baja más o menos la temperatura?", "o": ["Unos 12 °C", "Unos 2 °C", "Unos 50 °C", "No cambia"], "r": {"correcta": "Unos 12 °C"}, "e": "Unos 6 °C cada 1000 m."}], "3": [{"t": "matching", "p": "Uní cada ambiente con su actividad principal.", "o": {"izquierda": ["Pampa", "Andes", "Amazonia"], "derecha": ["Granos y carne", "Minería de cobre y litio", "Madera y ganado"]}, "r": {"pares": {"Pampa": "Granos y carne", "Andes": "Minería de cobre y litio", "Amazonia": "Madera y ganado"}}, "e": "Cada ambiente, transformado de una forma."}, {"t": "multiple_choice", "p": "¿Por qué la Amazonia importa para las lluvias de Argentina?", "o": ["Porque su humedad llega con los vientos hacia el sur", "Porque está en Argentina", "Porque es un desierto", "Porque produce litio"], "r": {"correcta": "Porque su humedad llega con los vientos hacia el sur"}, "e": "Los ambientes están conectados."}], "4": [{"t": "numeric", "p": "En un lugar la temperatura máxima es {a} °C y la mínima es {b} °C. ¿Cuál es la amplitud térmica?", "o": {"vars": {"a": {"min": 22, "max": 35}, "b": {"min": -5, "max": 12}}}, "r": {"formula": "a-b"}, "e": "Máxima menos mínima."}, {"t": "multiple_choice", "p": "En un climograma, barras muy bajas todo el año indican…", "o": ["Pocas lluvias", "Mucho frío", "Mucho calor", "Mucha población"], "r": {"correcta": "Pocas lluvias"}, "e": "Las barras son la lluvia."}], "5": [{"t": "multiple_choice", "p": "Relámpago. Las nubes son parte de la…", "o": ["Atmósfera", "Litósfera", "Biósfera"], "r": {"correcta": "Atmósfera"}, "e": "Capa de gases.", "tiempo": 20}, {"t": "multiple_choice", "p": "Relámpago. El promedio de muchos años es el…", "o": ["Clima", "Tiempo", "Bioma"], "r": {"correcta": "Clima"}, "e": "El tiempo es el de hoy.", "tiempo": 20}, {"t": "multiple_choice", "p": "Relámpago. El desierto no polar más seco es…", "o": ["Atacama", "Sahara", "Patagonia"], "r": {"correcta": "Atacama"}, "e": "En el norte de Chile.", "tiempo": 20}, {"t": "multiple_choice", "p": "Relámpago. En un climograma, la línea es…", "o": ["Temperatura", "Lluvia", "Altura"], "r": {"correcta": "Temperatura"}, "e": "Las barras son lluvia.", "tiempo": 20}]}, "examen": [[1, {"t": "multiple_choice", "p": "¿Qué esfera es la capa de gases que rodea la Tierra?", "o": ["Atmósfera", "Hidrósfera", "Litósfera", "Biósfera"], "r": {"correcta": "Atmósfera"}, "e": "Ahí pasa el tiempo."}], [1, {"t": "true_false", "p": "La mayor parte del agua del planeta es dulce.", "o": ["Verdadero", "Falso"], "r": {"correcta": "Falso"}, "e": "El 97 % es salada."}], [1, {"t": "multiple_choice", "p": "Un ambiente es…", "o": ["La naturaleza transformada por la sociedad", "Solo la naturaleza sin personas", "Solo las ciudades", "Un tipo de clima"], "r": {"correcta": "La naturaleza transformada por la sociedad"}, "e": "Natural y social."}], [2, {"t": "multiple_choice", "p": "\"En Mendoza llueve poco y hace calor en verano\" describe…", "o": ["El clima", "El tiempo", "Un bioma", "La latitud"], "r": {"correcta": "El clima"}, "e": "Habla de cómo es siempre."}], [2, {"t": "multiple_choice", "p": "¿Qué factor explica que haga más calor en Manaos que en Ushuaia?", "o": ["La latitud", "La altura", "El idioma", "La cantidad de habitantes"], "r": {"correcta": "La latitud"}, "e": "Manaos está cerca del Ecuador."}], [2, {"t": "true_false", "p": "En la tundra crecen grandes bosques.", "o": ["Verdadero", "Falso"], "r": {"correcta": "Falso"}, "e": "Solo musgos y líquenes."}], [3, {"t": "multiple_choice", "p": "La mayor parte de la Amazonia está en…", "o": ["Brasil", "Argentina", "Chile", "Uruguay"], "r": {"correcta": "Brasil"}, "e": "Casi dos tercios."}], [3, {"t": "multiple_choice", "p": "¿Qué mineral de los Andes es clave para las baterías?", "o": ["Litio", "Hierro", "Oro", "Carbón"], "r": {"correcta": "Litio"}, "e": "Celulares y autos eléctricos."}], [3, {"t": "true_false", "p": "La Pampa de hoy conserva casi todos sus pastizales originales.", "o": ["Verdadero", "Falso"], "r": {"correcta": "Falso"}, "e": "Se transformó en campos de cultivo y ganado."}], [4, {"t": "numeric", "p": "Máxima 26 °C, mínima 6 °C. ¿Amplitud térmica?", "o": {}, "r": {"acepta": [20]}, "e": "26 − 6."}], [4, {"t": "multiple_choice", "p": "En un climograma, las barras muestran…", "o": ["La lluvia", "La temperatura", "La población", "La altura"], "r": {"correcta": "La lluvia"}, "e": "En milímetros."}], [4, {"t": "multiple_choice", "p": "Un mapa que muestra solo dónde hay selvas es…", "o": ["Temático", "Político", "Físico", "Un planisferio en blanco"], "r": {"correcta": "Temático"}, "e": "Un solo tema."}], [4, {"t": "true_false", "p": "Cerca del mar la amplitud térmica suele ser menor que lejos del mar.", "o": ["Verdadero", "Falso"], "r": {"correcta": "Verdadero"}, "e": "El mar modera la temperatura."}]]}