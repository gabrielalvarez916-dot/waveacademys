{"subject_id": "e1b0726d-08aa-4d9e-9060-18489f529da2", "tema": 1, "practica": "Práctica general: volver a leer", "examen_titulo": "Nivel jefe: volver a leer", "niveles": {"1": {"objetivo": "Vas a repasar las estrategias de lectura: usar el paratexto, leer en tres momentos, reconocer la estructura de un relato y el narrador.", "vas_a_ver": ["El paratexto", "Leer en tres momentos", "Inferir", "Estructura del relato", "El narrador"], "secciones": [{"etapa": 1, "titulo": "El paratexto", "bloques": [{"tipo": "definicion", "titulo": "Paratexto", "texto": "Todo lo que acompaña al texto: <b>tapa, contratapa, título, autor, índice e imágenes</b>. Sirve para <b>anticipar</b> de qué trata antes de leer."}, {"tipo": "imagen", "imagen_tipo": "diagrama", "titulo": "Las partes de un libro", "texto": "Tapa, lomo, contratapa e índice: el paratexto.", "imagen_descripcion": "Libro desplegado con contratapa, lomo, tapa e índice marcados.", "imagen_fuente": "Dibujo propio (matplotlib).", "png_base64": ""}]}, {"etapa": 1, "titulo": "Leer en tres momentos", "bloques": [{"tipo": "tabla", "titulo": "Los tres momentos", "columnas": ["Momento", "Qué hago"], "filas": [["Antes", "Miro el paratexto y anticipo"], ["Durante", "Me hago preguntas, subrayo e infiero"], ["Después", "Resumo con mis palabras y opino"]], "iguales": true}, {"tipo": "definicion", "titulo": "Inferir", "texto": "Deducir lo que el texto <b>no dice</b> a partir de pistas. Si el perro volvió con barro hasta las orejas, se infiere que estuvo en un charco."}]}, {"etapa": 2, "titulo": "La estructura del relato", "bloques": [{"tipo": "tabla", "titulo": "Partes de un relato", "columnas": ["Parte", "Qué cuenta", "Ejemplo"], "filas": [["Situación inicial", "Quiénes, dónde, cómo están", "Tomi juega con su perro"], ["Conflicto", "Algo rompe la calma", "El perro se escapa"], ["Desenlace", "Cómo se resuelve", "Lo encuentra en la plaza"]], "iguales": true}]}, {"etapa": 2, "titulo": "El narrador", "bloques": [{"tipo": "parrafo", "texto": "El <b>narrador</b> es la voz que cuenta la historia; no es el autor. En <b>primera persona</b> es un personaje (\"yo busqué\"); en <b>tercera persona</b> cuenta desde afuera (\"Tomi buscó\")."}]}], "ejemplo_completo": {"titulo": "leer un cuento", "planteo": "Un cuento se titula \"La noche del apagón\" y en la tapa hay una vela. Aplicá los tres momentos.", "pasos": ["Antes: anticipo que habrá una noche sin luz y quizás algo de miedo.", "Durante: me pregunto qué pasará y busco pistas.", "Después: resumo la historia en tres oraciones.", "Opino si me gustó y por qué."]}, "ejemplo_incompleto": {"titulo": "completar", "planteo": "Completá los espacios.", "pasos": ["La parte del relato donde algo rompe la calma se llama ___ .", "Si el narrador dice \"yo corrí\", está en ___ persona."]}, "ejemplo_solo": {"titulo": "inferir", "planteo": "\"Ana entró empapada y dejó el paraguas roto en la puerta.\" ¿Qué podés inferir del tiempo afuera?"}, "tip": {"titulo": "Antes de leer, mirá", "texto": "Dedicale un minuto al paratexto: tapa, contratapa e índice. Vas a entender mucho más rápido."}, "ojo": ["Confundir al autor con el narrador.", "Empezar a leer sin mirar el paratexto."], "resumen": [{"titulo": "Paratexto", "texto": "Tapa, contratapa, índice: sirven para anticipar."}, {"titulo": "Tres momentos", "texto": "Antes, durante y después."}, {"titulo": "Estructura", "texto": "Situación inicial, conflicto, desenlace."}, {"titulo": "Narrador", "texto": "Primera o tercera persona."}], "glosario": [{"palabra": "Paratexto", "significado": "Lo que acompaña al texto."}, {"palabra": "Anticipar", "significado": "Imaginar de qué trata antes de leer."}, {"palabra": "Inferir", "significado": "Deducir lo que el texto no dice."}, {"palabra": "Conflicto", "significado": "Problema que rompe la situación inicial."}, {"palabra": "Narrador", "significado": "Voz que cuenta la historia."}], "carpeta": ["¿Cómo se llama la parte del relato donde se resuelve el problema?", "\"Yo abrí la puerta\": ¿primera o tercera persona?", "¿Cómo se llama todo lo que acompaña al texto (tapa, índice, contratapa)?", "¿Quién cuenta la historia: el autor o el narrador?"], "respuestas_carpeta": [["desenlace", "el desenlace"], ["primera", "primera persona", "1.ª", "1ra"], ["paratexto", "el paratexto"], ["narrador", "el narrador"]], "soluciones": {"incompleto": "Conflicto. Primera.", "solo": "Que llovía fuerte y había viento.", "carpeta": ["El desenlace.", "Primera persona.", "Paratexto.", "El narrador."]}}, "2": {"objetivo": "Vas a reconocer los géneros literarios y no literarios, y los subgéneros narrativos, para elegir mejor qué leer.", "vas_a_ver": ["Qué es un género", "Narrativo, poético, teatral y no literario", "Subgéneros narrativos", "Mito, leyenda, fábula y cuento"], "secciones": [{"etapa": 1, "titulo": "Las grandes familias", "bloques": [{"tipo": "definicion", "titulo": "Género", "texto": "Familia de textos que se parecen en su forma y en lo que buscan."}, {"tipo": "tabla", "titulo": "Géneros", "columnas": ["Género", "Qué hace", "Ejemplos"], "filas": [["Narrativo", "Cuenta una historia", "cuento, novela"], ["Poético", "Versos, ritmo, emociones", "poema, canción"], ["Teatral", "Diálogos para actuar", "obra de teatro"], ["No literario", "Informa o explica", "noticia, enciclopedia"]], "iguales": true}]}, {"etapa": 1, "titulo": "Subgéneros narrativos", "bloques": [{"tipo": "tabla", "titulo": "Subgéneros", "columnas": ["Subgénero", "Qué tiene"], "filas": [["Maravilloso", "Magia, hadas, dragones"], ["Ciencia ficción", "Futuro, ciencia y tecnología"], ["Policial", "Un enigma y alguien que lo resuelve"], ["Terror", "Busca provocar miedo"], ["Realista", "Hechos que podrían pasar"]], "iguales": true}]}, {"etapa": 2, "titulo": "Historias de siempre", "bloques": [{"tipo": "tabla", "titulo": "Relatos tradicionales", "columnas": ["Tipo", "Qué tiene"], "filas": [["Mito", "Dioses y héroes; explica el origen del mundo"], ["Leyenda", "Explica el origen de algo, en un lugar real"], ["Fábula", "Animales que hablan y una moraleja"], ["Cuento", "Ficción breve, de cualquier subgénero"]], "iguales": true}]}, {"etapa": 2, "titulo": "Elegir por género", "bloques": [{"tipo": "parrafo", "texto": "Conocer los géneros ayuda a saber qué esperar de un libro. Tener un género favorito está bien, pero probar otros puede llevarte a tu próximo libro preferido."}]}], "ejemplo_completo": {"titulo": "clasificar", "planteo": "Un relato cuenta cómo una diosa creó el río Paraná. ¿Qué es?", "pasos": ["Aparece una diosa.", "Explica el origen de algo de la naturaleza.", "Los relatos con dioses que explican orígenes son mitos.", "Es un mito."]}, "ejemplo_incompleto": {"titulo": "completar", "planteo": "Completá los espacios.", "pasos": ["Una historia con robots en el año 3000 es de ciencia ___ .", "La enseñanza final de una fábula se llama ___ ."]}, "ejemplo_solo": {"titulo": "tu turno", "planteo": "Pensá en un libro, película o serie que te guste. ¿A qué subgénero pertenece y por qué?"}, "tip": {"titulo": "Mirá los elementos", "texto": "Para saber el subgénero, buscá qué elementos aparecen: magia, tecnología, un crimen, algo que da miedo o hechos posibles."}, "ojo": ["Confundir mito y leyenda: el mito tiene dioses y explica el origen del mundo.", "Creer que todo texto es literario: la noticia informa."], "resumen": [{"titulo": "Género", "texto": "Familia de textos parecidos."}, {"titulo": "Familias", "texto": "Narrativo, poético, teatral, no literario."}, {"titulo": "Subgéneros", "texto": "Maravilloso, ciencia ficción, policial, terror, realista."}, {"titulo": "Tradicionales", "texto": "Mito, leyenda, fábula."}], "glosario": [{"palabra": "Género", "significado": "Familia de textos."}, {"palabra": "Subgénero", "significado": "Grupo dentro de un género."}, {"palabra": "Moraleja", "significado": "Enseñanza final de una fábula."}, {"palabra": "Mito", "significado": "Relato de dioses sobre el origen del mundo."}, {"palabra": "Leyenda", "significado": "Relato del origen de algo en un lugar real."}], "carpeta": ["Una historia con un crimen y un detective, ¿de qué subgénero es?", "¿Cómo se llama la enseñanza al final de una fábula?", "¿A qué género pertenece una noticia: literario o no literario?", "Un relato sobre el origen de la yerba mate en la selva misionera, ¿es mito o leyenda?"], "respuestas_carpeta": [["policial"], ["moraleja", "la moraleja"], ["no literario"], ["leyenda"]], "soluciones": {"incompleto": "Ficción. Moraleja.", "solo": "Respuesta personal: nombrá el subgénero y los elementos que lo muestran.", "carpeta": ["Policial.", "Moraleja.", "No literario.", "Leyenda."]}}, "3": {"objetivo": "Vas a escribir un texto de punto de partida usando el proceso de escritura, párrafos y conectores.", "vas_a_ver": ["El proceso de escritura", "Oración y párrafo", "Conectores", "Cómo armar mi punto de partida"], "secciones": [{"etapa": 1, "titulo": "El proceso de escritura", "bloques": [{"tipo": "tabla", "titulo": "Pasos para escribir", "columnas": ["Paso", "Qué hago"], "filas": [["Planificar", "Decido qué digo y en qué orden"], ["Borrador", "Escribo sin miedo a equivocarme"], ["Revisar", "Leo, corrijo y mejoro"], ["Pasar en limpio", "Escribo la versión final"]], "iguales": true}]}, {"etapa": 1, "titulo": "Oración y párrafo", "bloques": [{"tipo": "definicion", "titulo": "Oración", "texto": "Empieza con <b>mayúscula</b> y termina en <b>punto</b>. Tiene sentido completo."}, {"tipo": "definicion", "titulo": "Párrafo", "texto": "Grupo de oraciones sobre <b>una misma idea</b>. Termina en punto y aparte."}, {"tipo": "imagen", "imagen_tipo": "diagrama", "titulo": "Un párrafo, marcado", "texto": "Sangría, mayúscula, punto seguido y punto y aparte.", "imagen_descripcion": "Párrafo de tres líneas con sus marcas señaladas.", "imagen_fuente": "Dibujo propio (matplotlib).", "png_base64": ""}]}, {"etapa": 2, "titulo": "Conectores", "bloques": [{"tipo": "tabla", "titulo": "Conectores básicos", "columnas": ["Para…", "Conectores"], "filas": [["Sumar", "y, también, además"], ["Oponer", "pero, sin embargo"], ["Dar una causa", "porque, ya que"], ["Dar una consecuencia", "entonces, por eso"]], "iguales": true}]}, {"etapa": 2, "titulo": "Mi punto de partida", "bloques": [{"tipo": "ejemplo", "titulo": "Cuatro párrafos", "texto": "Un texto sobre mí como lector.", "items": ["1) Quién soy como lector.", "2) Un libro o historia que me gustó y por qué.", "3) Qué me cuesta al leer o escribir.", "4) Qué quiero lograr este año."]}]}], "ejemplo_completo": {"titulo": "un párrafo", "planteo": "Escribí el párrafo 2 del punto de partida.", "pasos": ["Elijo una historia: un cuento de terror que leí el año pasado.", "Digo por qué me gustó: me tuvo nervioso hasta el final.", "Uso un conector: \"porque\".", "Resultado: \"Me gustó mucho un cuento de terror porque me tuvo nervioso hasta el final.\""]}, "ejemplo_incompleto": {"titulo": "conectores", "planteo": "Completá con el conector adecuado.", "pasos": ["Me gusta leer, ___ no tengo mucho tiempo.", "Leí mucho este verano, ___ ahora leo más rápido."]}, "ejemplo_solo": {"titulo": "tu punto de partida", "planteo": "Escribí en tu carpeta tu texto de punto de partida con los cuatro párrafos."}, "tip": {"titulo": "Leelo en voz alta", "texto": "Al revisar, leé tu texto en voz alta: donde te quedás sin aire, falta un punto."}, "ojo": ["Escribir todo en una sola oración larguísima.", "Repetir \"y entonces\" en lugar de variar los conectores."], "resumen": [{"titulo": "Proceso", "texto": "Planificar, escribir, revisar, pasar en limpio."}, {"titulo": "Oración", "texto": "Mayúscula y punto."}, {"titulo": "Párrafo", "texto": "Una idea; punto y aparte."}, {"titulo": "Conectores", "texto": "Unen ideas: y, pero, porque, por eso."}], "glosario": [{"palabra": "Borrador", "significado": "Primera versión de un texto."}, {"palabra": "Revisar", "significado": "Releer para corregir y mejorar."}, {"palabra": "Oración", "significado": "De mayúscula a punto, con sentido completo."}, {"palabra": "Párrafo", "significado": "Oraciones sobre una misma idea."}, {"palabra": "Conector", "significado": "Palabra que une ideas."}], "carpeta": ["¿Cuántas oraciones hay en: \"Llegué tarde. Llovía y perdí el colectivo.\"? Respondé con un número.", "¿Qué conector opone ideas: \"porque\" o \"pero\"?", "¿Cómo termina un párrafo: con punto seguido o con punto y aparte?", "¿Cuál es el primer paso del proceso de escritura?"], "respuestas_carpeta": [["2", "dos"], ["pero"], ["punto y aparte", "con punto y aparte"], ["planificar"]], "soluciones": {"incompleto": "pero. por eso.", "solo": "Respuesta personal: revisá que tenga cuatro párrafos, mayúsculas, puntos y conectores.", "carpeta": ["2.", "Pero.", "Con punto y aparte.", "Planificar."]}}, "4": {"objetivo": "Vas a elegir libros usando el paratexto, armar fichas bibliográficas y planificar tu año lector.", "vas_a_ver": ["Elegir con el paratexto", "Cuatro preguntas para elegir", "La ficha bibliográfica", "Mi plan de lectura"], "secciones": [{"etapa": 1, "titulo": "Elegir con el paratexto", "bloques": [{"tipo": "tabla", "titulo": "Qué mirar", "columnas": ["Parte", "Qué me dice"], "filas": [["Tapa", "Título, autor, editorial"], ["Contratapa", "De qué trata, sin contar el final"], ["Índice", "Los capítulos y cómo está armado"]], "iguales": true}]}, {"etapa": 1, "titulo": "Cuatro preguntas", "bloques": [{"tipo": "parrafo", "texto": "<b>Género</b>: ¿qué tengo ganas de leer? <b>Recomendación</b>: ¿quién me lo aconsejó? <b>Primera página</b>: ¿me engancha? <b>Largo</b>: ¿me da el tiempo?"}]}, {"etapa": 2, "titulo": "La ficha bibliográfica", "bloques": [{"tipo": "definicion", "titulo": "Ficha bibliográfica", "texto": "Registra un libro con <b>autor</b> (apellido, nombre), <b>título</b>, <b>editorial</b> y <b>año</b>."}, {"tipo": "imagen", "imagen_tipo": "diagrama", "titulo": "Una ficha bibliográfica", "texto": "Autor, título, editorial y año.", "imagen_descripcion": "Ficha de cartulina con los cuatro datos de un libro.", "imagen_fuente": "Dibujo propio (matplotlib).", "png_base64": ""}]}, {"etapa": 2, "titulo": "Mi plan de lectura", "bloques": [{"tipo": "parrafo", "texto": "Tu año ya tiene paradas: un cuento policial, la novela <b>El fantasma de Canterville</b> de Oscar Wilde, poesía, teatro y un libro que elijas vos. Anotá en tu carpeta qué otros libros querés sumar. Y recordá: si un libro no te engancha, podés cambiarlo."}]}], "ejemplo_completo": {"titulo": "armar una ficha", "planteo": "El libro \"La isla del viento\", de Pablo Sosa, editorial Faro, año 2019. Armá la ficha.", "pasos": ["Autor: apellido primero, Sosa, Pablo.", "Título: La isla del viento.", "Editorial: Faro.", "Año: 2019."]}, "ejemplo_incompleto": {"titulo": "completar", "planteo": "Completá los espacios.", "pasos": ["En la ficha, el autor se escribe primero con el ___ .", "El resumen que dice de qué trata un libro está en la ___ ."]}, "ejemplo_solo": {"titulo": "tu ficha", "planteo": "Elegí un libro que tengas en casa y armá su ficha bibliográfica."}, "tip": {"titulo": "La primera página", "texto": "Antes de llevarte un libro, leé la primera página: si te dan ganas de seguir, es buena señal."}, "ojo": ["Elegir un libro solo por la tapa.", "Escribir el nombre antes del apellido en la ficha."], "resumen": [{"titulo": "Paratexto", "texto": "Tapa, contratapa, índice."}, {"titulo": "Elegir", "texto": "Género, recomendación, primera página, largo."}, {"titulo": "Ficha", "texto": "Autor, título, editorial, año."}, {"titulo": "Plan", "texto": "Mi año lector."}], "glosario": [{"palabra": "Contratapa", "significado": "Parte de atrás del libro con un resumen."}, {"palabra": "Índice", "significado": "Lista de capítulos."}, {"palabra": "Editorial", "significado": "Empresa que publica el libro."}, {"palabra": "Ficha bibliográfica", "significado": "Registro de los datos de un libro."}, {"palabra": "Plan de lectura", "significado": "Lista de libros para leer en un tiempo."}], "carpeta": ["¿Qué parte del libro tiene el resumen de qué trata?", "En la ficha, ¿qué va primero: el apellido o el nombre del autor?", "¿Qué dato falta en esta ficha: \"Ríos, Ana. El faro de los gatos. 2021.\"?", "¿Dónde están los capítulos de un libro?"], "respuestas_carpeta": [["contratapa", "la contratapa"], ["apellido", "el apellido"], ["editorial", "la editorial"], ["indice", "índice", "en el indice", "en el índice", "el índice"]], "soluciones": {"incompleto": "Apellido. Contratapa.", "solo": "Respuesta personal: apellido, nombre. Título. Editorial. Año.", "carpeta": ["La contratapa.", "El apellido.", "La editorial.", "En el índice."]}}}, "act": {"1": [{"t": "ordering", "p": "Ordená las partes del relato.", "o": ["Desenlace", "Situación inicial", "Conflicto"], "r": {"orden": ["Situación inicial", "Conflicto", "Desenlace"]}, "e": "Primero se presenta, después algo pasa y al final se resuelve."}, {"t": "multiple_choice", "p": "\"Mariana llegó con la ropa llena de harina.\" ¿Qué podés inferir?", "o": ["Estuvo cocinando", "Fue a nadar", "Estuvo durmiendo", "Leyó un libro"], "r": {"correcta": "Estuvo cocinando"}, "e": "La harina es una pista de que cocinó."}], "2": [{"t": "classify", "p": "Clasificá cada historia.", "o": {"elementos": ["Dragón y hechizo", "Robots en Marte", "Robo y detective", "Fantasma en el sótano"], "categorias": ["Maravilloso", "Ciencia ficción", "Policial", "Terror"]}, "r": {"categorias": {"Dragón y hechizo": "Maravilloso", "Robots en Marte": "Ciencia ficción", "Robo y detective": "Policial", "Fantasma en el sótano": "Terror"}}, "e": "Cada subgénero tiene sus elementos."}, {"t": "multiple_choice", "p": "Animales que hablan y una enseñanza al final:", "o": ["Mito", "Leyenda", "Fábula", "Noticia"], "r": {"correcta": "Fábula"}, "e": "La enseñanza es la moraleja."}], "3": [{"t": "multiple_choice", "p": "¿Qué conector completa? \"Estudié mucho, ___ me fue bien.\"", "o": ["pero", "por eso", "sin embargo", "aunque"], "r": {"correcta": "por eso"}, "e": "Es una consecuencia."}, {"t": "ordering", "p": "Ordená el proceso de escritura.", "o": ["Revisar", "Pasa